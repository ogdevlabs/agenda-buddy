{
    "openapi": "3.0.4",
    "info": {
        "title": "Calendar",
        "version": "1.0"
    },
    "paths": {
        "/api/v1/calendar/availability/{email}": {
            "get": {
                "tags": [
                    "CalendarAPI"
                ],
                "operationId": "CheckCalendarAvailability",
                "parameters": [
                    {
                        "name": "email",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "format": "date-time"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/v1/calendar/appointments/{email}": {
            "get": {
                "tags": [
                    "CalendarAPI"
                ],
                "operationId": "CheckCalendarAppointments",
                "parameters": [
                    {
                        "name": "email",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/AppointmentEntity"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AppointmentEntity": {
                "required": [
                    "emailCustomer",
                    "emailProvider"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/ObjectId"
                    },
                    "identifier": {
                        "type": "string",
                        "nullable": true
                    },
                    "emailProvider": {
                        "type": "string",
                        "format": "email",
                        "nullable": true
                    },
                    "emailCustomer": {
                        "type": "string",
                        "format": "email",
                        "nullable": true
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "appointmentStatus": {
                        "$ref": "#/components/schemas/AppointmentStatus"
                    },
                    "appointmentDescription": {
                        "type": "string",
                        "nullable": true
                    },
                    "dayOff": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            },
            "AppointmentStatus": {
                "enum": [
                    0,
                    1,
                    2,
                    3,
                    4
                ],
                "type": "integer",
                "format": "int32"
            },
            "ObjectId": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true
                    },
                    "machine": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true,
                        "deprecated": true
                    },
                    "pid": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true,
                        "deprecated": true
                    },
                    "increment": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true,
                        "deprecated": true
                    },
                    "creationTime": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "additionalProperties": false
            }
        }
    }
}
