{
    "openapi": "3.0.4",
    "info": {
        "title": "Provider",
        "version": "1.0"
    },
    "paths": {
        "/api/v1/providers": {
            "post": {
                "tags": [
                    "ProviderAPI"
                ],
                "operationId": "CreateProvider",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProviderEntity"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProviderEntity"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "tags": [
                    "ProviderAPI"
                ],
                "operationId": "GetAllProviders",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProviderSummaryPagedResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/providers/{email}": {
            "get": {
                "tags": [
                    "ProviderAPI"
                ],
                "operationId": "GetProviderByEmail",
                "parameters": [
                    {
                        "name": "email",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProviderSummary"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            },
            "put": {
                "tags": [
                    "ProviderAPI"
                ],
                "operationId": "UpdateProvider",
                "parameters": [
                    {
                        "name": "email",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProviderEntity"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    },
                    "202": {
                        "description": "Accepted"
                    }
                }
            }
        },
        "/api/v1/providers/{email}/report": {
            "get": {
                "tags": [
                    "ProviderAPI"
                ],
                "operationId": "GetProviderReport",
                "parameters": [
                    {
                        "name": "email",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProviderReport"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/api/v1/providers/{email}/deactivate": {
            "post": {
                "tags": [
                    "ProviderAPI"
                ],
                "operationId": "DeactivateProvider",
                "parameters": [
                    {
                        "name": "email",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AppointmentEntity": {
                "required": [
                    "emailCustomer",
                    "emailProvider"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/ObjectId"
                    },
                    "identifier": {
                        "type": "string",
                        "nullable": true
                    },
                    "emailProvider": {
                        "type": "string",
                        "format": "email",
                        "nullable": true
                    },
                    "emailCustomer": {
                        "type": "string",
                        "format": "email",
                        "nullable": true
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "appointmentStatus": {
                        "$ref": "#/components/schemas/AppointmentStatus"
                    },
                    "appointmentDescription": {
                        "type": "string",
                        "nullable": true
                    },
                    "dayOff": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            },
            "AppointmentStatus": {
                "enum": [
                    0,
                    1,
                    2,
                    3,
                    4
                ],
                "type": "integer",
                "format": "int32"
            },
            "FeeType": {
                "enum": [
                    0,
                    1,
                    2
                ],
                "type": "integer",
                "format": "int32"
            },
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "nullable": true
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "nullable": true
                    },
                    "instance": {
                        "type": "string",
                        "nullable": true
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "nullable": true
                    }
                },
                "additionalProperties": {}
            },
            "ObjectId": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true
                    },
                    "machine": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true,
                        "deprecated": true
                    },
                    "pid": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true,
                        "deprecated": true
                    },
                    "increment": {
                        "type": "integer",
                        "format": "int32",
                        "readOnly": true,
                        "deprecated": true
                    },
                    "creationTime": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "additionalProperties": false
            },
            "ProviderEntity": {
                "required": [
                    "email",
                    "firstName",
                    "lastName"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/ObjectId"
                    },
                    "firstName": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "lastName": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "email": {
                        "minLength": 1,
                        "type": "string",
                        "format": "email"
                    },
                    "kafkaTopic": {
                        "type": "string",
                        "nullable": true
                    },
                    "serviceEntities": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ServiceEntity"
                        },
                        "nullable": true
                    },
                    "appointmentEntities": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AppointmentEntity"
                        },
                        "nullable": true
                    },
                    "subscribedCustomerCollection": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "nullable": true
                    },
                    "isActive": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            },
            "ProviderReport": {
                "type": "object",
                "properties": {
                    "providerEmail": {
                        "type": "string",
                        "nullable": true
                    },
                    "totalBookings": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "completedAppointments": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "cancelledAppointments": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "uniqueCustomers": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "retentionRate": {
                        "type": "number",
                        "format": "double"
                    },
                    "revenueAvailable": {
                        "type": "boolean"
                    },
                    "revenueUnavailableReason": {
                        "type": "string",
                        "nullable": true
                    },
                    "generatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "additionalProperties": false
            },
            "ProviderSummary": {
                "required": [
                    "email",
                    "firstName",
                    "lastName",
                    "services"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "firstName": {
                        "type": "string",
                        "nullable": true
                    },
                    "lastName": {
                        "type": "string",
                        "nullable": true
                    },
                    "services": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ServiceEntity"
                        },
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "ProviderSummaryPagedResponse": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProviderSummary"
                        },
                        "nullable": true
                    },
                    "totalCount": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32"
                    }
                },
                "additionalProperties": false
            },
            "ServiceEntity": {
                "required": [
                    "description",
                    "name"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/ObjectId"
                    },
                    "name": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "description": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "fee": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "feeType": {
                        "$ref": "#/components/schemas/FeeType"
                    },
                    "isActive": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            }
        }
    }
}
