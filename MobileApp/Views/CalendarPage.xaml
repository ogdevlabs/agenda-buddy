<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Views.CalendarPage"
             Title="Calendar">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Activity indicator -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           Margin="0,8" />

        <!-- Error banner (UX F-002) -->
        <Frame Grid.Row="1"
               IsVisible="{Binding HasError}"
               BackgroundColor="#FDECEA"
               BorderColor="#F44336"
               Padding="12"
               Margin="16,4">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#B71C1C"
                       FontSize="14" />
                <Button Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        HorizontalOptions="Start"
                        Padding="12,6" />
            </VerticalStackLayout>
        </Frame>

        <!-- Calendar days list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Days}"
                        Margin="16,4">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4" Padding="12" BorderColor="#E0E0E0">
                        <Grid ColumnDefinitions="*,Auto,Auto">

                            <!-- Date -->
                            <Label Grid.Column="0"
                                   Text="{Binding Date}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />

                            <!-- Available slots count -->
                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center"
                                                 Margin="8,0">
                                <Label Text="{Binding AvailableSlots.Count}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#2E7D32"
                                       HorizontalOptions="Center" />
                                <Label Text="Available"
                                       FontSize="11"
                                       TextColor="#2E7D32"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Booked slots count -->
                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center"
                                                 Margin="8,0">
                                <Label Text="{Binding BookedSlots.Count}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#C62828"
                                       HorizontalOptions="Center" />
                                <Label Text="Booked"
                                       FontSize="11"
                                       TextColor="#C62828"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
