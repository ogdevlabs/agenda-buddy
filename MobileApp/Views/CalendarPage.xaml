<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.CalendarPage"
             Title="Calendar"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Immersive Header with gradient feel -->
        <Grid Grid.Row="0" Padding="0" BackgroundColor="{StaticResource BackgroundDark}">
            <BoxView BackgroundColor="{StaticResource BackgroundDark}" />
            <VerticalStackLayout Padding="24,20,24,24" Spacing="16">

                <!-- Month & Year -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding MonthYear}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding WeekLabel}"
                               FontSize="13"
                               TextColor="#A5B4FC"
                               Opacity="0.85" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="&#x25C0;"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoBack}"
                                BackgroundColor="#FFFFFF15"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="16"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0" />
                        <Button Text="&#x25B6;"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoForward}"
                                BackgroundColor="#FFFFFF15"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="16"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Horizontal day selector strip -->
                <CollectionView ItemsSource="{Binding Days}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedDay}"
                                HeightRequest="80"
                                ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame WidthRequest="58"
                                   HeightRequest="72"
                                   CornerRadius="18"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding IsSelected, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource Primary}, FalseObject=#FFFFFF12}}">
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Spacing="4">
                                    <Label Text="{Binding DayOfWeek}"
                                           FontSize="11"
                                           TextColor="{Binding IsSelected, Converter={toolkit:BoolToObjectConverter TrueObject=White, FalseObject=#A5B4FC}}"
                                           HorizontalOptions="Center"
                                           TextTransform="Uppercase" />
                                    <Label Text="{Binding DayNumber}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                    <!-- Dot indicator for bookings -->
                                    <BoxView WidthRequest="6"
                                             HeightRequest="6"
                                             CornerRadius="3"
                                             HorizontalOptions="Center"
                                             Color="{Binding HasBookings, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource Accent}, FalseObject=Transparent}}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Grid>

        <!-- Activity indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,24" />

        <!-- Error banner -->
        <Frame Grid.Row="2"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36" />
            </Grid>
        </Frame>

        <!-- Day detail content -->
        <ScrollView Grid.Row="3" Padding="20,16,20,0">
            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding HasSelectedDay}">

                <!-- Summary stats row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,4">
                    <Frame Grid.Column="0"
                           BackgroundColor="{StaticResource PrimarySubtle}"
                           CornerRadius="16"
                           Padding="16,14"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding SelectedDay.BookedSlots.Count}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Sessions"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1"
                           BackgroundColor="{StaticResource SuccessSubtle}"
                           CornerRadius="16"
                           Padding="16,14"
                           HasShadow="False"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding SelectedDay.AvailableSlots.Count}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Success}" />
                            <Label Text="Available"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Section: Booked sessions -->
                <Label Text="BOOKED SESSIONS"
                       Style="{StaticResource Overline}"
                       Margin="4,8,0,0"
                       IsVisible="{Binding SelectedDay.HasBookings}" />

                <CollectionView ItemsSource="{Binding SelectedDay.BookedSlots}"
                                SelectionMode="None"
                                IsVisible="{Binding SelectedDay.HasBookings}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="16"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="#F1F5F9"
                                   BackgroundColor="White">
                                <Grid ColumnDefinitions="5,*" ColumnSpacing="0">
                                    <!-- Accent left strip -->
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{StaticResource Accent}"
                                             WidthRequest="5"
                                             VerticalOptions="Fill"
                                             HorizontalOptions="Start" />
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="Auto,*,Auto"
                                          Padding="14,14,16,14"
                                          ColumnSpacing="12">
                                        <!-- Time circle -->
                                        <Frame Grid.Column="0"
                                               BackgroundColor="{StaticResource AccentLight}"
                                               CornerRadius="20"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               Padding="0"
                                               HasShadow="False"
                                               BorderColor="Transparent"
                                               VerticalOptions="Center">
                                            <Label Text="&#x1F552;"
                                                   FontSize="18"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Frame>
                                        <!-- Session info -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center"
                                                             Spacing="2">
                                            <Label Text="{Binding .}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="30 min session"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <!-- Status dot -->
                                        <Frame Grid.Column="2"
                                               BackgroundColor="{StaticResource Success}"
                                               CornerRadius="6"
                                               WidthRequest="12"
                                               HeightRequest="12"
                                               Padding="0"
                                               HasShadow="False"
                                               BorderColor="Transparent"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Section: Available slots -->
                <Label Text="AVAILABLE SLOTS"
                       Style="{StaticResource Overline}"
                       Margin="4,8,0,0"
                       IsVisible="{Binding HasAvailableSlots}" />

                <FlexLayout BindableLayout.ItemsSource="{Binding SelectedDay.AvailableSlots}"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            IsVisible="{Binding HasAvailableSlots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{StaticResource SuccessSubtle}"
                                   CornerRadius="12"
                                   Padding="12,8"
                                   Margin="0,0,8,8"
                                   HasShadow="False"
                                   BorderColor="{StaticResource Success}">
                                <Label Text="{Binding .}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Success}" />
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Empty state -->
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     Margin="0,40"
                                     IsVisible="{Binding SelectedDayIsEmpty}">
                    <Label Text="&#x1F4AD;"
                           FontSize="44"
                           HorizontalOptions="Center" />
                    <Label Text="No sessions scheduled"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                    <Label Text="This day is wide open"
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
