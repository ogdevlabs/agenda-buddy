<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.CalendarPage"
             Title="Calendar"
             BackgroundColor="{StaticResource BackgroundPage}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource Primary}"
               CornerRadius="0"
               BorderColor="Transparent"
               HasShadow="False"
               Padding="24,20">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="This Week"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextOnPrimary}"
                       HorizontalOptions="Center" />
                <Label Text="{Binding WeekLabel}"
                       FontSize="13"
                       TextColor="#C7D2FE"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <!-- Activity indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,24" />

        <!-- Error banner -->
        <Frame Grid.Row="2"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36" />
            </Grid>
        </Frame>

        <!-- Week days list -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Days}"
                        SelectionMode="None"
                        Margin="16,12,16,16"
                        ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Frame CornerRadius="20"
                                       Padding="16"
                                       BorderColor="#F1F5F9"
                                       BackgroundColor="White"
                                       HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleDayCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="10">

                                        <!-- Day header pill -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Day pill -->
                                            <Frame Grid.Column="0"
                                                   BackgroundColor="{Binding IsToday, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource Primary}, FalseObject={StaticResource PrimarySubtle}}}"
                                                   CornerRadius="14"
                                                   Padding="14,8"
                                                   HasShadow="False"
                                                   BorderColor="Transparent">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding DayOfWeek}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding IsToday, Converter={toolkit:BoolToObjectConverter TrueObject=White, FalseObject={StaticResource Primary}}}"
                                                           TextTransform="Uppercase" />
                                                    <Label Text="{Binding DayNumber}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding IsToday, Converter={toolkit:BoolToObjectConverter TrueObject=White, FalseObject={StaticResource Primary}}}" />
                                                </HorizontalStackLayout>
                                            </Frame>

                                            <!-- Session count -->
                                            <HorizontalStackLayout Grid.Column="2"
                                                                   Spacing="8"
                                                                   VerticalOptions="Center">
                                                <Frame BackgroundColor="{StaticResource Accent}"
                                                       CornerRadius="10"
                                                       Padding="8,4"
                                                       HasShadow="False"
                                                       BorderColor="Transparent">
                                                    <Label Text="{Binding BookedSlots.Count, StringFormat='{0} sessions'}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="White" />
                                                </Frame>
                                                <Frame BackgroundColor="{StaticResource SuccessSubtle}"
                                                       CornerRadius="10"
                                                       Padding="8,4"
                                                       HasShadow="False"
                                                       BorderColor="Transparent">
                                                    <Label Text="{Binding AvailableSlots.Count, StringFormat='{0} open'}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Success}" />
                                                </Frame>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- Booked slots (30-min sessions) — collapsed by default -->
                                        <CollectionView ItemsSource="{Binding BookedSlots}"
                                                        SelectionMode="None"
                                                        IsVisible="{Binding ShowSlots}">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Frame BackgroundColor="#FEF3C7"
                                                           CornerRadius="12"
                                                           Padding="12,8"
                                                           HasShadow="False"
                                                           BorderColor="#FCD34D">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                            <!-- Time icon -->
                                                            <Frame Grid.Column="0"
                                                                   BackgroundColor="{StaticResource Accent}"
                                                                   CornerRadius="10"
                                                                   WidthRequest="20"
                                                                   HeightRequest="20"
                                                                   Padding="0"
                                                                   HasShadow="False"
                                                                   BorderColor="Transparent"
                                                                   VerticalOptions="Center" />

                                                            <!-- Slot text: "9:00 AM — Alex Chen" -->
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding .}"
                                                                   FontSize="13"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#92400E"
                                                                   VerticalOptions="Center" />

                                                            <!-- Duration badge -->
                                                            <Frame Grid.Column="2"
                                                                   BackgroundColor="#FDE68A"
                                                                   CornerRadius="8"
                                                                   Padding="6,2"
                                                                   HasShadow="False"
                                                                   BorderColor="Transparent"
                                                                   VerticalOptions="Center">
                                                                <Label Text="30 min"
                                                                       FontSize="10"
                                                                       TextColor="#92400E" />
                                                            </Frame>
                                                        </Grid>
                                                    </Frame>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <!-- Collapsed hint -->
                                        <Label Text="Tap to expand sessions"
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}"
                                               IsVisible="{Binding ShowSlots, Converter={toolkit:InvertedBoolConverter}}"
                                               Margin="4,0">
                                            <Label.IsVisible>
                                                <MultiBinding Converter="{toolkit:VariableMultiValueConverter ConditionType=All}">
                                                    <Binding Path="HasBookings" />
                                                    <Binding Path="IsExpanded" Converter="{toolkit:InvertedBoolConverter}" />
                                                </MultiBinding>
                                            </Label.IsVisible>
                                        </Label>

                                        <!-- No bookings message -->
                                        <Label Text="No sessions — all day open"
                                               FontSize="13"
                                               TextColor="{StaticResource TextMuted}"
                                               IsVisible="{Binding HasBookings, Converter={toolkit:InvertedBoolConverter}}"
                                               Margin="4,0" />

                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
