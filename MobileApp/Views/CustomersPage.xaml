<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.CustomersPage"
             Title="Customers"
             BackgroundColor="{StaticResource BackgroundPage}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Search bar -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource BackgroundCard}"
               CornerRadius="12"
               BorderColor="{StaticResource BorderLight}"
               Padding="16,4"
               HasShadow="False"
               Margin="24,16,24,8">
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="&#x1F50D;"
                       FontSize="16"
                       VerticalOptions="Center"
                       Margin="0,0,8,0" />
                <Entry Grid.Column="1"
                       Placeholder="Search customers..."
                       Style="{StaticResource InputStyle}"
                       FontSize="15"
                       BackgroundColor="Transparent" />
            </Grid>
        </Frame>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,16,0,0" />

        <!-- Error banner -->
        <Frame Grid.Row="2"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center"
                       AutomationId="ErrorLabel" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36"
                        AutomationId="RetryButton" />
            </Grid>
        </Frame>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="3"
                             IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="40">
            <Frame BackgroundColor="{StaticResource PrimarySubtle}"
                   CornerRadius="40"
                   WidthRequest="80"
                   HeightRequest="80"
                   Padding="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="&#x1F465;"
                       FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>
            <Label Text="No customers yet"
                   Style="{StaticResource TitleSmall}"
                   HorizontalOptions="Center" />
            <Label Text="Once a client books a session with you, they will appear here."
                   Style="{StaticResource BodySecondary}"
                   HorizontalTextAlignment="Center"
                   AutomationId="EmptyStateLabel" />
        </VerticalStackLayout>

        <!-- Customer list -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Customers}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                        SelectionMode="None"
                        Margin="24,8,24,24"
                        AutomationId="CustomersCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardCompact}"
                           Margin="0,0,0,10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCustomerCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">

                            <!-- Collapsed row -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Frame Grid.Column="0"
                                       Style="{StaticResource AvatarCircle}">
                                    <Label Text="{Binding Initial}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding FullName}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"
                                           AutomationId="CustomerFullName" />
                                    <Label Text="{Binding LastSession}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <Frame Grid.Column="2"
                                       BackgroundColor="{StaticResource PrimarySubtle}"
                                       CornerRadius="10"
                                       Padding="8,4"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding TotalSessions, StringFormat='{0} sessions'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Frame>
                            </Grid>

                            <!-- Expanded details -->
                            <VerticalStackLayout Spacing="8"
                                                 Margin="0,12,0,0"
                                                 IsVisible="{Binding IsExpanded}">
                                <BoxView HeightRequest="1" Color="#F1F5F9" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Label Grid.Column="0" Text="Email:" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding Email}" FontSize="13" TextColor="{StaticResource TextPrimary}" AutomationId="CustomerEmail" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="Phone:" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding Phone}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="Last:" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding LastSession}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                </Grid>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
