<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="{StaticResource BackgroundPage}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Activity indicator -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,16" />

        <!-- Error banner -->
        <Frame Grid.Row="1"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36" />
            </Grid>
        </Frame>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="40">
            <Frame BackgroundColor="{StaticResource SuccessLight}"
                   CornerRadius="40"
                   WidthRequest="80"
                   HeightRequest="80"
                   Padding="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="&#x2713;"
                       FontSize="36"
                       TextColor="{StaticResource Success}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>
            <Label Text="All caught up!"
                   Style="{StaticResource TitleSmall}"
                   HorizontalOptions="Center" />
            <Label Text="New booking updates will appear here."
                   Style="{StaticResource BodySecondary}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Notifications list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Notifications}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="24,8,24,24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{StaticResource BackgroundCard}"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="True"
                           BorderColor="{StaticResource BorderLight}"
                           Margin="0,0,0,10">

                        <Grid ColumnDefinitions="5,Auto,*,Auto"
                              Padding="0"
                              ColumnSpacing="0">

                            <!-- Unread accent bar (left edge) -->
                            <BoxView Grid.Column="0"
                                     Color="{Binding IsRead, Converter={toolkit:BoolToObjectConverter TrueObject=Transparent, FalseObject=#4F46E5}}"
                                     WidthRequest="5"
                                     VerticalOptions="Fill" />

                            <!-- Type icon circle -->
                            <Frame Grid.Column="1"
                                   BackgroundColor="{StaticResource PrimarySubtle}"
                                   CornerRadius="18"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   Margin="12,16,0,16"
                                   VerticalOptions="Center">
                                <Label Text="&#x1F514;"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>

                            <!-- Content -->
                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="4"
                                                 Padding="12,16"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding NotificationType}"
                                       FontAttributes="{Binding IsRead, Converter={toolkit:BoolToObjectConverter TrueObject=None, FalseObject=Bold}}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Message}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, h:mm tt}'}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <!-- Mark as read button -->
                            <ImageButton Grid.Column="3"
                                         Source="envelope_open.png"
                                         IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkReadCommand}"
                                         CommandParameter="{Binding Id}"
                                         WidthRequest="28"
                                         HeightRequest="28"
                                         Margin="0,0,16,0"
                                         VerticalOptions="Center">
                                <SemanticProperties.Description>Mark as read</SemanticProperties.Description>
                            </ImageButton>

                            <!-- Tap gesture for the whole row -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkReadCommand}"
                                    CommandParameter="{Binding Id}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
