<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="{StaticResource BackgroundPage}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Activity indicator -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,16" />

        <!-- Error banner -->
        <Frame Grid.Row="1"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36" />
            </Grid>
        </Frame>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="40">
            <Frame BackgroundColor="{StaticResource SuccessLight}"
                   CornerRadius="40"
                   WidthRequest="80"
                   HeightRequest="80"
                   Padding="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="&#x2713;"
                       FontSize="36"
                       TextColor="{StaticResource Success}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>
            <Label Text="All caught up!"
                   Style="{StaticResource TitleSmall}"
                   HorizontalOptions="Center" />
            <Label Text="New booking updates will appear here."
                   Style="{StaticResource BodySecondary}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Notifications list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Notifications}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                        SelectionMode="None"
                        Margin="24,8,24,24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{StaticResource BackgroundCard}"
                           CornerRadius="16"
                           Padding="0"
                           HasShadow="True"
                           BorderColor="{StaticResource BorderLight}"
                           Margin="0,0,0,10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleNotificationCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="0">

                            <!-- Collapsed row -->
                            <Grid ColumnDefinitions="5,Auto,*,Auto"
                                  Padding="0"
                                  ColumnSpacing="0">

                                <!-- Unread accent bar -->
                                <BoxView Grid.Column="0"
                                         Color="{Binding IsRead, Converter={toolkit:BoolToObjectConverter TrueObject=Transparent, FalseObject=#4F46E5}}"
                                         WidthRequest="5"
                                         VerticalOptions="Fill" />

                                <!-- Type icon -->
                                <Frame Grid.Column="1"
                                       BackgroundColor="{StaticResource PrimarySubtle}"
                                       CornerRadius="18"
                                       WidthRequest="36"
                                       HeightRequest="36"
                                       Padding="0"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       Margin="12,14,0,14"
                                       VerticalOptions="Center">
                                    <Label Text="&#x1F514;"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <!-- Summary -->
                                <VerticalStackLayout Grid.Column="2"
                                                     Spacing="2"
                                                     Padding="12,14"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding TypeLabel}"
                                           FontAttributes="{Binding IsRead, Converter={toolkit:BoolToObjectConverter TrueObject=None, FalseObject=Bold}}"
                                           FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding TimeAgo}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <!-- Unread dot -->
                                <Frame Grid.Column="3"
                                       IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}"
                                       BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="5"
                                       WidthRequest="10"
                                       HeightRequest="10"
                                       Padding="0"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       Margin="0,0,16,0"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Expanded content -->
                            <VerticalStackLayout Spacing="8"
                                                 Margin="16,0,16,14"
                                                 IsVisible="{Binding IsExpanded}">
                                <BoxView HeightRequest="1" Color="#E2E8F0" />
                                <Label Text="{Binding Message}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="WordWrap"
                                       Margin="0,4,0,0" />
                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, h:mm tt}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
