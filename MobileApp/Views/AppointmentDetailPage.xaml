<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.AppointmentDetailPage"
             Title="Appointment"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero header -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="24,48,24,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Back button -->
            <Button Grid.Row="0"
                    Text="&#x2190; Back"
                    BackgroundColor="Transparent"
                    TextColor="#C7D2FE"
                    FontSize="14"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,0,0,16"
                    Clicked="OnBackClicked" />

            <!-- Large avatar -->
            <Frame Grid.Row="1"
                   BackgroundColor="#FFFFFF30"
                   CornerRadius="36"
                   WidthRequest="72"
                   HeightRequest="72"
                   Padding="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="{Binding Appointment.CustomerEmail, StringFormat='{0[0]}'}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextTransform="Uppercase" />
            </Frame>

            <!-- Customer name -->
            <Label Grid.Row="2"
                   Text="{Binding Appointment.CustomerEmail}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,12,0,4" />

            <!-- Status pill -->
            <Frame Grid.Row="3"
                   BackgroundColor="#FFFFFF25"
                   CornerRadius="14"
                   Padding="14,6"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="{Binding Appointment.Status}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="White"
                       TextTransform="Uppercase"
                       CharacterSpacing="1"
                       AutomationId="StatusLabel" />
            </Frame>
        </Grid>

        <!-- Error banner -->
        <Frame Grid.Row="1"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,12"
               VerticalOptions="Start">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center"
                       AutomationId="ErrorBanner" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36"
                        AutomationId="TryAgainButton" />
            </Grid>
        </Frame>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Detail content -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding HasAppointment}"
                    Margin="0,-20,0,0">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="14">

                <!-- Date & time card -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource PrimarySubtle}"
                               CornerRadius="16"
                               WidthRequest="52"
                               HeightRequest="52"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:dd}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:MMM}'}"
                                       FontSize="10"
                                       TextColor="{StaticResource Primary}"
                                       TextTransform="Uppercase"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:dddd}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:h:mm tt}'}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Duration card -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource AccentLight}"
                               CornerRadius="16"
                               WidthRequest="52"
                               HeightRequest="52"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent">
                            <Label Text="30"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AccentDark}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="Duration"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="30 minutes"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Provider card -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource SuccessSubtle}"
                               CornerRadius="16"
                               WidthRequest="52"
                               HeightRequest="52"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent">
                            <Label Text="{Binding Appointment.ProviderEmail, StringFormat='{0[0]}'}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Success}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextTransform="Uppercase" />
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="Provider"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   TextTransform="Uppercase"
                                   CharacterSpacing="1" />
                            <Label Text="{Binding Appointment.ProviderEmail}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Action buttons -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               CornerRadius="0"
               BorderColor="#E2E8F0"
               HasShadow="True"
               Padding="20,16">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                <Button Grid.Column="0"
                        Text="Confirm"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        AutomationId="ConfirmButton" />

                <Button Grid.Column="1"
                        Text="Cancel"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        AutomationId="CancelButton" />

                <Button Grid.Column="2"
                        Text="Complete"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="14"
                        Padding="12,14"
                        Command="{Binding CompleteCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        AutomationId="CompleteButton" />

            </Grid>
        </Frame>

    </Grid>

</ContentPage>
