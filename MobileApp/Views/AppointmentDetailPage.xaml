<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.AppointmentDetailPage"
             Title="Appointment"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero header — customer-focused -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="24,48,24,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Back button -->
            <Button Grid.Row="0"
                    Text="&#x2190; Back"
                    BackgroundColor="Transparent"
                    TextColor="#C7D2FE"
                    FontSize="14"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,0,0,16"
                    Clicked="OnBackClicked" />

            <!-- Customer avatar -->
            <Frame Grid.Row="1"
                   BackgroundColor="#FFFFFF30"
                   CornerRadius="36"
                   WidthRequest="72"
                   HeightRequest="72"
                   Padding="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="{Binding Appointment.CustomerName, StringFormat='{0[0]}'}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextTransform="Uppercase" />
            </Frame>

            <!-- Customer name -->
            <Label Grid.Row="2"
                   Text="{Binding Appointment.CustomerName}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,12,0,4" />

            <!-- Service type pill -->
            <Frame Grid.Row="3"
                   BackgroundColor="{StaticResource Accent}"
                   CornerRadius="14"
                   Padding="14,6"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center"
                   Margin="0,4">
                <Label Text="{Binding Appointment.ServiceName}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Frame>

            <!-- Status pill -->
            <Frame Grid.Row="4"
                   BackgroundColor="#FFFFFF25"
                   CornerRadius="12"
                   Padding="12,5"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center"
                   Margin="0,6,0,0">
                <Label Text="{Binding Appointment.Status}"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="White"
                       TextTransform="Uppercase"
                       CharacterSpacing="1"
                       AutomationId="StatusLabel" />
            </Frame>
        </Grid>

        <!-- Error banner -->
        <Frame Grid.Row="1"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,12"
               VerticalOptions="Start">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center"
                       AutomationId="ErrorBanner" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36"
                        AutomationId="TryAgainButton" />
            </Grid>
        </Frame>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Detail cards -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding HasAppointment}"
                    Margin="0,-16,0,0">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="14">

                <!-- Schedule card -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource PrimarySubtle}"
                               CornerRadius="16"
                               WidthRequest="52"
                               HeightRequest="52"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:dd}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:MMM}'}"
                                       FontSize="10"
                                       TextColor="{StaticResource Primary}"
                                       TextTransform="Uppercase"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Frame>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:dddd}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:h:mm tt} · 30 min'}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Customer contact card -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="CONTACT"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               TextTransform="Uppercase"
                               CharacterSpacing="1.5" />

                        <!-- Email -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame Grid.Column="0"
                                   BackgroundColor="{StaticResource PrimarySubtle}"
                                   CornerRadius="12"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                <Label Text="&#x2709;"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="{Binding Appointment.CustomerEmail}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Phone -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame Grid.Column="0"
                                   BackgroundColor="{StaticResource SuccessSubtle}"
                                   CornerRadius="12"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                <Label Text="&#x260E;"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="{Binding Appointment.CustomerPhone}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Customer notes card (only visible if notes exist) -->
                <Frame CornerRadius="20"
                       BackgroundColor="#FFFBEB"
                       BorderColor="#FCD34D"
                       HasShadow="True"
                       Padding="20"
                       IsVisible="{Binding Appointment.HasNotes}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#x1F4DD;"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Text="CUSTOMER NOTES"
                                   FontSize="11"
                                   TextColor="#92400E"
                                   TextTransform="Uppercase"
                                   CharacterSpacing="1.5"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Appointment.CustomerNotes}"
                               FontSize="15"
                               TextColor="#78350F"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Action buttons -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               CornerRadius="0"
               BorderColor="#E2E8F0"
               HasShadow="True"
               Padding="20,16">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                <Button Grid.Column="0"
                        Text="Confirm"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        AutomationId="ConfirmButton" />

                <Button Grid.Column="1"
                        Text="Cancel"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        AutomationId="CancelButton" />

                <Button Grid.Column="2"
                        Text="Complete"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="14"
                        Padding="12,14"
                        Command="{Binding CompleteCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        AutomationId="CompleteButton" />

            </Grid>
        </Frame>

    </Grid>

</ContentPage>
