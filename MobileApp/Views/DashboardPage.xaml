<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:System="clr-namespace:System;assembly=netstandard"
             x:Class="MobileApp.Views.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsLoading}">

        <ScrollView>
            <VerticalStackLayout Padding="24,16" Spacing="0">

                <!-- Greeting Header -->
                <VerticalStackLayout Spacing="4" Margin="0,16,0,24">
                    <Label Text="{Binding Greeting}"
                           Style="{StaticResource TitleLarge}"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='{0:dddd, MMMM d}'}"
                           Style="{StaticResource BodySecondary}" />
                </VerticalStackLayout>

                <!-- Summary Cards Row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,24">

                    <!-- Today's Sessions Card -->
                    <Frame Grid.Column="0"
                           BackgroundColor="{StaticResource Primary}"
                           CornerRadius="16"
                           BorderColor="Transparent"
                           HasShadow="False"
                           Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TODAY"
                                   FontSize="11"
                                   CharacterSpacing="1.5"
                                   TextTransform="Uppercase"
                                   TextColor="#C7D2FE" />
                            <Label Text="{Binding TodayCount}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextOnPrimary}" />
                            <Label Text="Sessions"
                                   FontSize="14"
                                   TextColor="#C7D2FE" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- This Week Card -->
                    <Frame Grid.Column="1"
                           BackgroundColor="{StaticResource AccentLight}"
                           CornerRadius="16"
                           BorderColor="Transparent"
                           HasShadow="False"
                           Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="THIS WEEK"
                                   FontSize="11"
                                   CharacterSpacing="1.5"
                                   TextTransform="Uppercase"
                                   TextColor="{StaticResource AccentDark}" />
                            <Label Text="{Binding WeekCount}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Upcoming"
                                   FontSize="14"
                                   TextColor="{StaticResource AccentDark}" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Error banner -->
                <Frame Style="{StaticResource ErrorBannerStyle}"
                       IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="14"
                               VerticalOptions="Center"
                               AutomationId="ErrorBanner" />
                        <Button Grid.Column="1"
                                Text="Retry"
                                Command="{Binding LoadCommand}"
                                BackgroundColor="{StaticResource Error}"
                                TextColor="White"
                                CornerRadius="16"
                                FontSize="13"
                                Padding="12,6"
                                HeightRequest="36"
                                AutomationId="TryAgainButton" />
                    </Grid>
                </Frame>

                <!-- Section Header with paging -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <Label Grid.Column="0"
                           Text="Appointments"
                           Style="{StaticResource TitleSmall}"
                           VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="&#x25C0;"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoBack}"
                                BackgroundColor="{StaticResource PrimarySubtle}"
                                TextColor="{StaticResource Primary}"
                                FontSize="14"
                                CornerRadius="14"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0" />
                        <Label Text="{Binding PageLabel}"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                        <Button Text="&#x25B6;"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoForward}"
                                BackgroundColor="{StaticResource PrimarySubtle}"
                                TextColor="{StaticResource Primary}"
                                FontSize="14"
                                CornerRadius="14"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,24" />

                <!-- Empty state -->
                <Frame Style="{StaticResource CardStyle}"
                       IsVisible="{Binding IsEmpty}"
                       Margin="0,8">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Padding="16">
                        <Label Text="&#x1F4C5;"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="No appointments today"
                               Style="{StaticResource TitleSmall}"
                               HorizontalOptions="Center" />
                        <Label Text="Check your calendar for upcoming sessions."
                               Style="{StaticResource BodySecondary}"
                               HorizontalTextAlignment="Center"
                               AutomationId="EmptyStateLabel" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Appointments list -->
                <CollectionView ItemsSource="{Binding Appointments}"
                                SelectionMode="None"
                                AutomationId="AppointmentsCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardCompact}"
                                   Margin="0,0,0,10">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAppointmentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="0">

                                    <!-- Collapsed row -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Frame Grid.Column="0"
                                               Style="{StaticResource AvatarCircle}">
                                            <Label Text="{Binding DisplayName, StringFormat='{0[0]}'}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextTransform="Uppercase" />
                                        </Frame>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding ScheduledAt, StringFormat='{0:h:mm tt} · {0:MMM d}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>

                                        <Frame Grid.Column="2"
                                               Style="{StaticResource BadgeStyle}"
                                               BackgroundColor="{StaticResource SuccessLight}"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Success}" />
                                        </Frame>
                                    </Grid>

                                    <!-- Expanded details -->
                                    <VerticalStackLayout Spacing="8"
                                                         Margin="0,12,0,0"
                                                         IsVisible="{Binding IsExpanded}">
                                        <BoxView HeightRequest="1" Color="#E2E8F0" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                            <Label Grid.Column="0" Text="Service:" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                            <Label Grid.Column="1" Text="{Binding ServiceName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="Phone:" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                            <Label Grid.Column="1" Text="{Binding CustomerPhone}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="Notes:" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                            <Label Grid.Column="1" Text="{Binding CustomerNotes}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                        </Grid>
                                        <Button Text="View Details"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                CornerRadius="14"
                                                FontSize="13"
                                                HeightRequest="36"
                                                Padding="16,0"
                                                HorizontalOptions="End"
                                                Margin="0,4,0,0"
                                                Clicked="OnViewDetailsClicked"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Logout -->
                <Button Text="Sign Out"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextMuted}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        Margin="0,24,0,8"
                        Clicked="OnLogoutClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </RefreshView>

</ContentPage>
