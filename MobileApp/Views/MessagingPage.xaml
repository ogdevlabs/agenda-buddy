<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.Views.MessagingPage"
             Title="Messages"
             BackgroundColor="{StaticResource BackgroundPage}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Error banner -->
        <Frame Grid.Row="0"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Error}"
                        FontAttributes="Bold"
                        FontSize="13" />
            </Grid>
        </Frame>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,24" />

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="40">
            <Frame BackgroundColor="{StaticResource PrimarySubtle}"
                   CornerRadius="40"
                   WidthRequest="80"
                   HeightRequest="80"
                   Padding="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   HorizontalOptions="Center">
                <Label Text="&#x1F4AC;"
                       FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>
            <Label Text="No messages yet"
                   Style="{StaticResource TitleSmall}"
                   HorizontalOptions="Center" />
            <Label Text="Your conversations with clients will appear here."
                   Style="{StaticResource BodySecondary}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Thread list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Threads}"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        SelectionMode="None"
                        Margin="24,8,24,24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{StaticResource BackgroundCard}"
                           CornerRadius="16"
                           BorderColor="{StaticResource Divider}"
                           Padding="16"
                           HasShadow="False"
                           Margin="0,0,0,10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleThreadCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="0">

                            <!-- Collapsed row -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Frame Grid.Column="0"
                                       Style="{StaticResource AvatarCircle}">
                                    <Label Text="{Binding Initial}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding SenderName}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TimeAgo}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <Frame Grid.Column="2"
                                       IsVisible="{Binding UnreadCount}"
                                       BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="12"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       Padding="0"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding UnreadCount}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                            </Grid>

                            <!-- Expanded content -->
                            <VerticalStackLayout Spacing="8"
                                                 Margin="0,12,0,0"
                                                 IsVisible="{Binding IsExpanded}">
                                <BoxView HeightRequest="1" Color="#E2E8F0" />
                                <Frame BackgroundColor="{StaticResource PrimarySubtle}"
                                       CornerRadius="12"
                                       Padding="12"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       Margin="0,4,0,0">
                                    <Label Text="{Binding LastMessageBody}"
                                           FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="WordWrap" />
                                </Frame>
                                <Label Text="{Binding OtherPartyEmail}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       Margin="4,0,0,0" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
