<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            CI or local dev without MAUI workloads: pass /p:MobileWorkloads=false to build on net10.0.
            Full mobile build (iOS + Android): requires 'dotnet workload install maui' or CI with workloads.
            Default is mobile TFMs so Visual Studio / Rider picks up the correct build.
        -->
        <MobileWorkloads Condition="'$(MobileWorkloads)' == ''">true</MobileWorkloads>
        <!--
            MobilePlatform: set to 'android' or 'ios' from CI to restrict the build to one platform
            without cascading a TargetFrameworks override to project references (Library.csproj).
            When workloads are present and no platform is pinned: build android + ios + net10.0
            so MobileApp.Tests (net10.0) can resolve the project reference.
            When workloads are absent: net10.0 only.
        -->
        <TargetFrameworks Condition="'$(MobileWorkloads)' != 'true'">net10.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(MobileWorkloads)' == 'true' AND '$(MobilePlatform)' == 'android'">net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(MobileWorkloads)' == 'true' AND '$(MobilePlatform)' == 'ios'">net10.0-ios</TargetFrameworks>
        <TargetFrameworks Condition="'$(MobileWorkloads)' == 'true' AND '$(MobilePlatform)' == ''">net10.0-android;net10.0-ios;net10.0</TargetFrameworks>
        <UseMaui Condition="'$(MobileWorkloads)' == 'true'">true</UseMaui>
        <UseMaui Condition="'$(MobileWorkloads)' != 'true'">false</UseMaui>
        <!-- Exe is required to package/launch on the mobile TFMs; net10.0 stays Library so MobileApp.Tests can reference it. -->
        <OutputType Condition="'$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'">Exe</OutputType>
        <RootNamespace>MobileApp</RootNamespace>
        <AssemblyName>MobileApp</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <SingleProject Condition="'$(MobileWorkloads)' == 'true'">true</SingleProject>
        <!-- MOBILE is true only for the actual mobile TFMs, not the net10.0 fallback slice -->
        <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'">$(DefineConstants);MOBILE</DefineConstants>
        <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-android'">$(DefineConstants);FIREBASE</DefineConstants>
        <!-- Suppress MA002: explicit package refs are managed via Directory.Build.props overrides -->
        <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
        <ApplicationTitle>Agenda Buddy</ApplicationTitle>
        <ApplicationId>com.fererelabs.agendabuddy</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">18.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>
        <!-- Allow minor Xcode version mismatches (e.g. 26.5 vs required 26.4) — forward-compatible -->
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" Condition="'$(UseMaui)' == 'true'" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
        <PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.0.0" Condition="'$(UseMaui)' == 'true' AND '$(TargetFramework)' != 'net10.0-ios'" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Library\Library.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MobileApp.Tests" />
    </ItemGroup>

    <!-- App resources (only when building MAUI targets) -->
    <ItemGroup Condition="'$(UseMaui)' == 'true'">
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
    </ItemGroup>

    <!-- The Maui SDK normally auto-excludes non-matching Platforms/<X> folders per TFM, but that
         only activates when UseMaui=true. The net10.0 fallback slice (MobileWorkloads=false) has
         UseMaui=false, so the plain SDK glob would otherwise pull in Android/iOS-only code. -->
    <ItemGroup Condition="'$(UseMaui)' != 'true'">
        <Compile Remove="Platforms\**\*.cs" />
    </ItemGroup>

</Project>
