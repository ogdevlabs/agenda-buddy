meta {
  name: 3 Create customer
  type: http
  seq: 3
}
post {
  url: {{gatewayUrl}}/api/v1/customers
  body: json
}
body:json {
  {
    "firstName": "Ada",
    "lastName": "Lovelace",
    "email": "{{customerEmail}}"
  }
}
docs {
  ⚠️ A `400` carrying a Kafka error means no broker is running — this handler creates a per-customer
  Kafka topic.
}
