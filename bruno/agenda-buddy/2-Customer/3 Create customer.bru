meta {
  name: 3 Create customer
  type: http
  seq: 3
}
post {
  url: {{gatewayUrl}}/api/v1/customers
  body: json
}
body:json {
  {
    "firstName": "Ada",
    "lastName": "Lovelace",
    "email": "{{customerEmail}}"
  }
}
docs {
  Requires the `Customer` role and an `email` matching the caller's `sub` claim. Profile creation writes
  MongoDB and dispatches through MediatR in-process; it has no broker or topic-creation dependency.
}
