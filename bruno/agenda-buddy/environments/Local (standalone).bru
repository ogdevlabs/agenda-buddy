vars {
  gatewayUrl: http://localhost:PORT
  providerUrl: http://localhost:6030
  servicesUrl: http://localhost:6031
  calendarUrl: http://localhost:6032
  bookingUrl: http://localhost:6033
  customerUrl: http://localhost:6034
  professionUrl: http://localhost:6035
  identityUrl: http://localhost:6036
  providerEmail: provider@example.com
  customerEmail: customer@example.com
  password: hunter2-at-least-8-chars
  role: Provider
  # Fill from a `8-Notifications/1 List notifications` response before calling `3 Mark one read`.
  notificationId: 000000000000000000000000
  messageId: 000000000000000000000000
  # Fill from a `4-Booking/1 Book appointment` response before calling the reschedule requests.
  appointmentIdentifier: 00000000-0000-0000-0000-000000000000
  # Fill from a `3-Calendar/3 List time off` response before calling `6 Remove time off`.
  calendarBlockIdentifier: 00000000-0000-0000-0000-000000000000
}

vars:secret [
  accessToken,
  refreshToken
]
