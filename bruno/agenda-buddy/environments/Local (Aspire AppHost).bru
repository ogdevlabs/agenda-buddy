vars {
  # Fixed — the Gateway's host port is pinned for local runs (AgendaBuddy.Library/LocalGatewayAddress.cs),
  # so this one needs no per-run discovery. Requests through it reach any service via api/v1/{service}/**.
  # The seven below stay PORT placeholders on purpose: they address each service DIRECTLY, bypassing the
  # Gateway, and those ports are still AppHost-assigned per run (AC-1.4).
  gatewayUrl: http://localhost:6080
  providerUrl: http://localhost:PORT
  servicesUrl: http://localhost:PORT
  calendarUrl: http://localhost:PORT
  bookingUrl: http://localhost:PORT
  customerUrl: http://localhost:PORT
  professionUrl: http://localhost:PORT
  identityUrl: http://localhost:PORT
  providerEmail: provider@example.com
  customerEmail: customer@example.com
  password: hunter2-at-least-8-chars
  role: Provider
  # Fill from a `8-Notifications/1 List notifications` response before calling `3 Mark one read`.
  notificationId: 000000000000000000000000
}

vars:secret [
  accessToken,
  refreshToken
]
