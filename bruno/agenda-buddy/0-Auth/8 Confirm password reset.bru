meta {
  name: 8 Confirm password reset
  type: http
  seq: 8
}
post {
  url: {{gatewayUrl}}/api/v1/auth/password-reset/confirm
  body: json
  auth: none
}
body:json {
  {
    "email": "{{providerEmail}}",
    "token": "paste the token logged by 6 Request password reset here",
    "newPassword": "{{password}}"
  }
}
tests {
  test("204 on a valid, unexpired, unused token", function () { expect(res.getStatus()).to.equal(204); });
}
docs {
  Single-use and short-lived (30 minutes) — a second attempt with the same token, or one made after
  expiry, gets `401`. On success, every existing session (refresh token) and any lockout on the
  account are cleared too, same as a real "forgot password" flow.
}
