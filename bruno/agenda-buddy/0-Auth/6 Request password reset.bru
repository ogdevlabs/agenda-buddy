meta {
  name: 6 Request password reset
  type: http
  seq: 6
}
post {
  url: {{gatewayUrl}}/api/v1/auth/password-reset/request
  body: json
  auth: none
}
body:json {
  {
    "email": "{{providerEmail}}"
  }
}
tests {
  test("202 regardless of whether the account exists", function () { expect(res.getStatus()).to.equal(202); });
}
docs {
  Always `202`, whether or not `email` matches an account — anti-enumeration, same principle as
  `/login`'s constant-time dummy hash.

  No real email/SMS provider exists in this project (ADR-052): the reset token is logged by the
  Identity service at Information level (visible in the Aspire dashboard), not actually delivered.
  Copy it from there to use with **7 Confirm password reset**.
}
