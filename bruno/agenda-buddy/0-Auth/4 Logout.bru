meta {
  name: 4 Logout
  type: http
  seq: 4
}
post {
  url: {{gatewayUrl}}/api/v1/auth/logout
  body: json
  auth: none
}
body:json {
  {
    "refreshToken": "{{refreshToken}}",
    "accessToken": "{{accessToken}}"
  }
}
docs {
  Revokes the refresh token server-side, and denylists the access token's `jti` so it stops working
  immediately rather than staying valid for its remaining lifetime. `accessToken` is optional — omitting
  it clears the refresh token only, same as before.
}
