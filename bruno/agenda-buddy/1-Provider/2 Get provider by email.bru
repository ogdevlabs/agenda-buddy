meta {
  name: 2 Get provider by email
  type: http
  seq: 3
}
get {
  url: {{gatewayUrl}}/api/v1/providers/{{providerEmail}}
}
tests {
  test("200 or 404", function () { expect([200, 404]).to.include(res.getStatus()); });
}
docs {
  **Two response shapes, chosen by ownership.** If your token's `sub` matches `{email}` you get the full
  `ProviderEntity` including your appointment book. Anyone else gets a `ProviderSummary`.

  Deliberately **not `403`** for a provider you do not own — reading another provider's *summary* is the
  discovery flow. Only the embedded data is withheld.
}
