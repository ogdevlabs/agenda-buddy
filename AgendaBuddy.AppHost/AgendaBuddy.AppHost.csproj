<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAspireHost>true</IsAspireHost>
        <UserSecretsId>agenda-buddy-apphost</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
        <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.4.6" />
        <PackageReference Include="Aspire.Hosting.Kafka" Version="13.5.3" />
        <!-- Publish target: turns the graph into Azure Container Apps infrastructure. Used only
             when publishing (see AppHostWiring.DeploymentTarget.Cloud); a local run never touches
             it, so it costs nothing at development time. -->
        <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.4.6" />
    </ItemGroup>

    <!-- The seven API services. MobileApp is absent by construction (AC-1.5) and CI asserts it
         stays absent — a MAUI head has no place in a server orchestration graph. -->
    <ItemGroup>
        <ProjectReference Include="..\Booking\Booking.csproj" />
        <ProjectReference Include="..\Calendar\Calendar.csproj" />
        <ProjectReference Include="..\Customer\Customer.csproj" />
        <ProjectReference Include="..\Identity\Identity.csproj" />
        <ProjectReference Include="..\Profession\Profession.csproj" />
        <ProjectReference Include="..\Provider\Provider.csproj" />
        <ProjectReference Include="..\Services\Services.csproj" />
        <!-- F-015-T05: the eighth process. Referenced here (not just added to agenda-buddy.sln) so
             the Aspire AppHost SDK generates Projects.Gateway, the same source-generated metadata
             type every other AddProject<TProject> call below relies on. -->
        <ProjectReference Include="..\Gateway\Gateway.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AgendaBuddy.AppHost.Tests" />
    </ItemGroup>

</Project>
