<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- F-015-T01: pure scaffold. No YARP yet (F-015-T03 adds Yarp.ReverseProxy and the routing
             config), no MongoDB.Driver, no MediatR, no auth package — the gateway has no business logic,
             no persistence, and no authentication middleware of its own (ARCHITECTURE.md §2, "Auth
             passthrough"). AgendaBuddy.ServiceDefaults is the only reference every service — including
             this one — needs for telemetry, health checks, service discovery, and HTTP resilience. -->
        <ProjectReference Include="..\AgendaBuddy.ServiceDefaults\AgendaBuddy.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- F-015-T02 spike: the one new package ARCHITECTURE.md §7 names explicitly. Read routes/
             clusters programmatically from Aspire's service-discovery configuration keys via a custom
             IProxyConfigProvider (AspireServiceDiscoveryProxyConfigProvider) rather than LoadFromConfig's
             static appsettings-file binding. -->
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>

</Project>
