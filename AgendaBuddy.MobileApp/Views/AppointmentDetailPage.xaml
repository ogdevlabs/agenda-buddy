<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.AppointmentDetailPage"
             Title="Appointment"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <controls:BrandHeader Grid.Row="0" />

        <!-- Two rows: the header, then the scrolling body. The third row used to hold a pinned action
             bar; the actions are a tab section now, so nothing is pinned here. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <!-- Header: the SERVICE is the title — it is what the appointment actually is. The counterpart's
                 name, the date and the time all moved into the single card below, replacing an avatar
                 monogram, a name label and two coloured pills. -->
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource Primary}"
                  Padding="24,16,24,28"
                  RowDefinitions="Auto,Auto,Auto">

                <controls:SafeButton Grid.Row="0"
                        Text="&#x2190; Back"
                        BackgroundColor="Transparent"
                        TextColor="#C7D2FE"
                        FontSize="14"
                        HorizontalOptions="Start"
                        Padding="4"
                        Margin="0,0,0,12"
                        Clicked="OnBackClicked" />

                <Label Grid.Row="1"
                       Text="{Binding Appointment.ServiceName}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="WordWrap" />

                <!-- Status as plain text rather than a pill. The pill was #FFFFFF25, which MAUI reads as
                     #AARRGGBB — opaque (255,255,37), i.e. yellow, not translucent white. -->
                <Label Grid.Row="2"
                       Text="{Binding Appointment.Status}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#C7D2FE"
                       TextTransform="Uppercase"
                       CharacterSpacing="1.5"
                       Margin="0,6,0,0"
                       AutomationId="StatusLabel" />
            </Grid>

            <!-- Error banner -->
            <Frame Grid.Row="1"
                   Style="{StaticResource ErrorBannerStyle}"
                   IsVisible="{Binding HasError}"
                   Margin="24,12"
                   VerticalOptions="Start">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Error}"
                           FontSize="14"
                           VerticalOptions="Center"
                           AutomationId="ErrorBanner" />
                    <controls:SafeButton Grid.Column="1"
                            Text="Retry"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="{StaticResource Error}"
                            TextColor="White"
                            CornerRadius="16"
                            FontSize="13"
                            Padding="12,6"
                            HeightRequest="36"
                            AutomationId="TryAgainButton" />
                </Grid>
            </Frame>

            <!-- Loading -->
            <ActivityIndicator Grid.Row="1"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <!-- SESSION FACTS, then TABS.
                 The facts stay visible because they are the identity of the thing being looked at, not one of
                 its sections. What the tabs divide is what you can DO about it — and before this the page
                 stacked the facts, the customer's note, a payment row, the notes editor and a growing action
                 row into one scroller, which put the actions below the fold on a short screen and made the
                 reason somebody opened the page the hardest thing to reach. -->
            <ScrollView Grid.Row="1"
                        IsVisible="{Binding HasAppointment}"
                        Margin="0,-16,0,0">
                <VerticalStackLayout Padding="20,0,20,24" Spacing="14">

                    <!-- ONE card: who it is with, when, and how to reach them. Previously two cards plus a
                         date tile and two icon chips; the information is the same, with four fewer components. -->
                    <Frame CornerRadius="20"
                           BackgroundColor="White"
                           BorderColor="#E2E8F0"
                           HasShadow="True"
                           Padding="20">
                        <VerticalStackLayout Spacing="14">

                            <!-- Counterpart: the provider when a customer is looking, the customer when a
                                 provider is. The avatar is the same mark Contacts, Messages, the Dashboard and
                                 the Calendar show for this person. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:Avatar Grid.Column="0"
                                                 Size="48"
                                                 Source="{Binding Appointment.AvatarAsset}"
                                                 AutomationId="CounterpartAvatar" />
                                <Label Grid.Column="1"
                                       Text="{Binding Appointment.DisplayName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Grid>

                            <!-- Date and time on one line each, no tile. -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Appointment.ScheduledAt, StringFormat='{0:dddd d MMMM}'}"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding TimeAndDurationLabel}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

                                <!-- Where it was before it was moved. Without this a rescheduled session reads
                                     exactly as one that was always at this time, so somebody who half-remembers
                                     the old slot has no way to confirm the change was real. -->
                                <Label Text="{Binding PreviousTimeLabel}"
                                       IsVisible="{Binding WasRescheduled}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       AutomationId="PreviousTimeLabel" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEF1F6" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Appointment.ContactEmail}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Appointment.ContactPhone}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"
                                       IsVisible="{Binding HasContactPhone}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Customer notes, only when there are some. Was an amber card with an emoji; the note is
                         information, not a warning, so it reads in the same neutral treatment as everything else. -->
                    <Frame CornerRadius="20"
                           BackgroundColor="White"
                           BorderColor="#E2E8F0"
                           HasShadow="True"
                           Padding="20"
                           IsVisible="{Binding Appointment.HasNotes}">
                        <!-- Stays OUTSIDE the tabs: the customer's note is context for the session, not one of
                             the things you can do about it. -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="NOTES FROM CUSTOMER"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   TextTransform="Uppercase"
                                   CharacterSpacing="1.5" />
                            <Label Text="{Binding Appointment.CustomerNotes}"
                                   FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- TAB STRIP. Three tappable segments, not a Picker: the sections are peers and all of
                         them should be visible at once, which is the whole reason to use tabs here. The Notes
                         segment is absent for a customer rather than disabled — the backend note routes are
                         Provider-role-gated, so it could only ever open an empty section. -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">

                        <Frame Grid.Column="0" CornerRadius="12" Padding="0" HasShadow="False"
                               BackgroundColor="White" BorderColor="#E2E8F0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                                      CommandParameter="Manage" />
                            </Frame.GestureRecognizers>
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsManageTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Label Text="Manage" FontSize="14" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Padding="0,12"
                                   TextColor="{StaticResource TextPrimary}"
                                   AutomationId="ManageTabButton">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsManageTab}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Frame>

                        <Frame Grid.Column="1" CornerRadius="12" Padding="0" HasShadow="False"
                               BackgroundColor="White" BorderColor="#E2E8F0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                                      CommandParameter="Payment" />
                            </Frame.GestureRecognizers>
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsPaymentTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Label Text="Payment" FontSize="14" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Padding="0,12"
                                   TextColor="{StaticResource TextPrimary}"
                                   AutomationId="PaymentTabButton">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPaymentTab}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Frame>

                        <Frame Grid.Column="2" CornerRadius="12" Padding="0" HasShadow="False"
                               BackgroundColor="White" BorderColor="#E2E8F0"
                               IsVisible="{Binding ShowNotesTab}" MinimumWidthRequest="96">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                                      CommandParameter="Notes" />
                            </Frame.GestureRecognizers>
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsNotesTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Label Text="Notes" FontSize="14" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Padding="14,12"
                                   TextColor="{StaticResource TextPrimary}"
                                   AutomationId="NotesTabButton">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsNotesTab}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Frame>

                    </Grid>

                    <!-- ══ MANAGE TAB ══ The default, because reschedule/cancel is why people open this page. -->
                    <Frame
                       BackgroundColor="White"
                       CornerRadius="20"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20,16"
                       IsVisible="{Binding ShowManageSection}">
                    <VerticalStackLayout Spacing="10">

                        <!-- A proposal is outstanding. Worded entirely differently by who is waiting on whom, and it
                             always restates where the session STILL is: a proposed time is not the appointment. -->
                        <Frame IsVisible="{Binding HasPendingReschedule}"
                               BackgroundColor="#FFFBEB" BorderColor="#F59E0B" CornerRadius="12"
                               HasShadow="False" Padding="14">
                            <Label Text="{Binding PendingRescheduleMessage}" FontSize="13"
                                   TextColor="{StaticResource TextPrimary}"
                                   AutomationId="PendingRescheduleMessage" />
                        </Frame>

                        <!-- Approve / Decline, shown only to the party who did NOT propose. The server refuses an
                             answer from the proposer, so offering it to them would be two buttons that both 409. -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                              IsVisible="{Binding ShowRescheduleAnswerButtons}">
                            <controls:SafeButton Grid.Column="0"
                                    Text="Approve new time"
                                    Style="{StaticResource SuccessButton}"
                                    FontSize="14"
                                    Command="{Binding ApproveRescheduleCommand}"
                                    IsEnabled="{Binding IsNotLoading}"
                                    AutomationId="ApproveRescheduleButton" />
                            <controls:SafeButton Grid.Column="1"
                                    Text="Decline"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="14"
                                    Command="{Binding DeclineRescheduleCommand}"
                                    IsEnabled="{Binding IsNotLoading}"
                                    AutomationId="DeclineRescheduleButton" />
                        </Grid>

                        <!-- Confirm: the provider accepting a REQUEST, so it only ever applies to a Requested
                             session and never sits beside Reschedule or Complete, which are for a Booked one. -->
                        <controls:SafeButton Text="Confirm"
                                Style="{StaticResource SuccessButton}"
                                FontSize="14"
                                Command="{Binding ConfirmCommand}"
                                IsEnabled="{Binding IsNotLoading}"
                                IsVisible="{Binding ShowConfirmButton}"
                                AutomationId="ConfirmButton" />

                        <!-- Reschedule and Complete: equal halves, colour-coded by what they DO rather than by
                             prominence. Amber for rescheduling — it changes a commitment both parties agreed to,
                             which is neither a success nor a destruction — and green for completing, the one
                             that closes the session out. Cancel stays the red outline below.
                             The provider MOVES a session; a customer ASKS, and their button is below, because
                             the calendar belongs to the provider — that asymmetry is the product decision, not
                             a permissions accident. -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <controls:SafeButton Grid.Column="0"
                                    Text="Reschedule"
                                    Style="{StaticResource WarningButton}"
                                    FontSize="14"
                                    Padding="12,14"
                                    Command="{Binding RescheduleCommand}"
                                    IsVisible="{Binding ShowRescheduleButton}"
                                    IsEnabled="{Binding IsNotLoading}"
                                    AutomationId="RescheduleButton" />

                            <!-- Complete button + activity indicator, matching the Sign In
                                 button/ActivityIndicator overlay pattern on LoginPage. -->
                            <Grid Grid.Column="1">
                                <controls:SafeButton Text="Complete"
                                        Style="{StaticResource SuccessButton}"
                                        FontSize="14"
                                        Padding="12,14"
                                        Command="{Binding CompleteCommand}"
                                        IsEnabled="{Binding IsNotLoading}"
                                        IsVisible="{Binding ShowCompleteButtonIdle}"
                                        AutomationId="CompleteButton" />
                                <ActivityIndicator IsRunning="{Binding ShowCompletingIndicator}"
                                                   IsVisible="{Binding ShowCompletingIndicator}"
                                                   Color="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   AutomationId="CompleteButtonBusyIndicator" />
                            </Grid>
                        </Grid>

                        <!-- The customer's counterpart to Reschedule. Full width because a customer has no
                             Complete to sit beside: Complete is a claim about work delivered, which is the
                             provider's to make. -->
                        <controls:SafeButton Text="Request a new time"
                                Style="{StaticResource WarningButton}"
                                FontSize="14"
                                Command="{Binding RequestNewTimeCommand}"
                                IsVisible="{Binding ShowRequestNewTimeButton}"
                                IsEnabled="{Binding IsNotLoading}"
                                AutomationId="RequestNewTimeButton" />

                        <!-- Cancel. A provider may cancel at any notice; a customer only outside the 24-hour
                             window, and inside it the button is replaced by the reason rather than greyed. -->
                        <controls:SafeButton Text="Cancel"
                                Style="{StaticResource DangerButton}"
                                FontSize="14"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding ShowCancelButton}"
                                IsEnabled="{Binding IsNotLoading}"
                                AutomationId="CancelButton" />

                        <!-- Shown while cancelling is still possible, so the deadline is not discovered by being
                             refused. -->
                        <Label Text="{Binding CancellationDeadlineMessage}"
                               IsVisible="{Binding ShowCancellationDeadlineNotice}"
                               FontSize="11" TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center"
                               AutomationId="CancellationDeadlineMessage" />

                        <!-- And in place of the button once it has passed. A missing button with no explanation is
                             indistinguishable from a bug. -->
                        <Frame IsVisible="{Binding ShowCancellationClosedNotice}"
                               BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="12"
                               HasShadow="False" Padding="12">
                            <Label Text="{Binding CancellationClosedMessage}" FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   AutomationId="CancellationClosedMessage" />
                        </Frame>

                        <ActivityIndicator IsRunning="{Binding IsRescheduling}" IsVisible="{Binding IsRescheduling}"
                                           Color="{StaticResource Primary}" HorizontalOptions="Center"
                                           AutomationId="RescheduleBusyIndicator" />

                    </VerticalStackLayout>
                </Frame>

                    <!-- ══ PAYMENT TAB ══ -->
                    <Frame CornerRadius="20"
                           BackgroundColor="White"
                           BorderColor="#E2E8F0"
                           HasShadow="True"
                           Padding="20"
                           IsVisible="{Binding IsPaymentTab}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="PAYMENT"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   TextTransform="Uppercase"
                                   CharacterSpacing="1.5" />

                            <!-- The fee that was agreed, from the appointment itself. Named here because a
                                 payment screen that shows no amount leaves the reader to remember it. -->
                            <Label Text="{Binding PaymentSummary}"
                                   FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap"
                                   AutomationId="PaymentSummary" />

                            <!-- No action here on purpose: payments are being handled outside this screen, so
                                 the tab states what the session costs and nothing more. A button opening a
                                 payment flow this app is not driving would be an offer it cannot keep. -->
                        </VerticalStackLayout>
                    </Frame>

                    <!-- ══ NOTES TAB ══ Provider-only; IsNotesTab folds the role gate in, so a customer has
                         neither the tab nor the section. -->
                    <Frame CornerRadius="20"
                           BackgroundColor="White"
                           BorderColor="#E2E8F0"
                           HasShadow="True"
                           Padding="20"
                           IsVisible="{Binding IsNotesTab}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="SESSION NOTES"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   TextTransform="Uppercase"
                                   CharacterSpacing="1.5" />

                            <Frame Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasNotesError}">
                                <Label Text="{Binding NotesErrorMessage}" TextColor="{StaticResource Error}" FontSize="13" />
                            </Frame>

                            <ActivityIndicator IsRunning="{Binding IsLoadingNotes}" IsVisible="{Binding IsLoadingNotes}"
                                               Color="{StaticResource Primary}" HorizontalOptions="Center" />

                            <!-- BindableLayout, not a CollectionView: this sits inside the page's ScrollView,
                                 and a virtualizing list nested in a scroller gets unbounded height, renders
                                 everything and pushes the add-note field off the screen. A session's notes are
                                 a bounded handful, so nothing is lost. -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notes}"
                                                 IsVisible="{Binding HasSessionNotes}"
                                                 AutomationId="NotesList">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="2" Margin="0,4">
                                            <Label Text="{Binding Content}" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                            <BoxView HeightRequest="0.5" Color="#F1F5F9" Margin="0,6,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Empty state: a notes tab with nothing in it should say so rather than look
                                 broken. -->
                            <Label Text="No notes on this session yet."
                                   IsVisible="{Binding HasNoSessionNotes}"
                                   FontSize="13" TextColor="{StaticResource TextMuted}"
                                   AutomationId="NoSessionNotesLabel" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <Frame Grid.Column="0" Style="{StaticResource InputFrame}" Margin="0">
                                    <Entry Text="{Binding NewNoteContent}"
                                           Placeholder="Add a note..."
                                           Style="{StaticResource InputStyle}"
                                           AutomationId="NewNoteEntry" />
                                </Frame>
                                <controls:SafeButton Grid.Column="1"
                                        Text="Add"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="13"
                                        Padding="16,8"
                                        HeightRequest="44"
                                        Command="{Binding AddNoteCommand}"
                                        AutomationId="AddNoteButton" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ACTION ROW.
                 Reworked from a fixed 3-column Grid (Confirm / Cancel / Complete), which was already full and
                 could not take Reschedule, Request new time, Approve and Decline. Every action is now visibility-
                 gated on the appointment's status AND the reader's role, laid out in wrapping rows rather than
                 fixed columns, so the row shows exactly what is actually available and nothing else.

                 Every gate HIDES rather than disables. A greyed button with no explanation reads as broken, and a
                 button the server will refuse is worse: an ungated affordance is what made a messaging 403
                 surface to the user as a connection failure. Where an action is withheld for a reason the reader
                 can act on — the cancellation window having closed — the reason takes its place. -->
        </Grid>

    </Grid>

</ContentPage>
