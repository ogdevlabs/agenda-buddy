<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AgendaBuddy.MobileApp.Resources.Strings"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.MessagingPage"
             Title="{x:Static strings:AppResources.Xaml_Messages}"
             BackgroundColor="#F2F2F7"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <Color x:Key="iOSBlue">#007AFF</Color>
        <Color x:Key="iOSGray">#8E8E93</Color>
        <Color x:Key="iOSGray5">#E5E5EA</Color>
        <Color x:Key="iOSLabel">#000000</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <controls:BrandHeader Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*">

            <!-- Header -->
            <Grid Grid.Row="0"
                  BackgroundColor="White"
                  Padding="20,16,20,12"
                  ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{x:Static strings:AppResources.Xaml_Messages}"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="{StaticResource iOSLabel}"
                       VerticalOptions="Center" />

                <!-- This tab can only ever list threads that already exist, so without a way out to the
                     contact list neither side could say anything first. -->
                <controls:SafeButton Grid.Column="1"
                        Text="{x:Static strings:AppResources.Xaml_New}"
                        BackgroundColor="#E0F2FE"
                        TextColor="#0369A1"
                        CornerRadius="10"
                        FontSize="15"
                        FontAttributes="Bold"
                        HeightRequest="38"
                        Padding="18,4"
                        VerticalOptions="Center"
                        Clicked="OnNewMessageClicked"
                        AutomationId="NewMessageButton" />
            </Grid>

            <!-- Error banner -->
            <Frame Grid.Row="1"
                   BackgroundColor="#FFF2F2"
                   CornerRadius="10"
                   BorderColor="#FFD6D6"
                   Padding="14,10"
                   HasShadow="False"
                   IsVisible="{Binding HasError}"
                   Margin="16,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           TextColor="#FF3B30"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <controls:SafeButton Grid.Column="1"
                            Text="{x:Static strings:AppResources.Xaml_Retry}"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource iOSBlue}"
                            FontAttributes="Bold"
                            FontSize="14" />
                </Grid>
            </Frame>

            <!-- Loading indicator -->
            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource iOSGray}"
                               HorizontalOptions="Center"
                               Margin="0,24" />

            <!-- Empty state -->
            <VerticalStackLayout Grid.Row="3"
                                 IsVisible="{Binding IsEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Padding="40">
                <Label Text="{x:Static strings:AppResources.Xaml_NoMessages}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource iOSLabel}"
                       HorizontalOptions="Center" />
                <Label Text="{x:Static strings:AppResources.Xaml_TapNewToMessageSomeoneYouHaveBookedWith}"
                       FontSize="15"
                       TextColor="{StaticResource iOSGray}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Thread list -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding Threads}"
                            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid BackgroundColor="White">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenThreadCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout Spacing="0">
                                <!-- Main row -->
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="16,12,16,12"
                                      ColumnSpacing="12">

                                    <!--
                                        Derived from the other party's address: a thread stub is built from
                                        messages and carries no profile, so there is no assigned avatar to read.
                                        The derivation is stable, which is what makes the same person show the
                                        same mark here and in the contacts list.
                                    -->
                                    <!-- The shared control: the circular-clip markup was 16 lines repeated per surface, and the
                                         two copies had already drifted in how they RESOLVED the image. -->
                                    <controls:Avatar Grid.Column="0"
                                                     Size="48"
                                                     VerticalOptions="Start"
                                                     Source="{Binding AvatarAsset}"
                                                     AutomationId="ThreadAvatar" />

                                    <!-- Name + preview -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding SenderName}"
                                               FontSize="16"
                                               FontAttributes="{Binding HasUnread, Converter={toolkit:BoolToObjectConverter TrueObject=Bold, FalseObject=None}}"
                                               TextColor="{StaticResource iOSLabel}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding LastMessageBody}"
                                               FontSize="14"
                                               TextColor="{StaticResource iOSGray}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <!-- Time + badge -->
                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="6"
                                                         VerticalOptions="Start"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding TimeAgo}"
                                               FontSize="13"
                                               TextColor="{StaticResource iOSGray}"
                                               HorizontalOptions="End" />
                                        <!--
                                            The pill GROWS with its label rather than being a fixed 22pt circle
                                            the text is clipped by: a thread with 252 unread rendered as a
                                            cropped "252". UnreadLabel caps the text itself at "99+", so the
                                            pill never has to be wide enough for four digits.
                                        -->
                                        <Border IsVisible="{Binding HasUnread}"
                                                HorizontalOptions="End"
                                                BackgroundColor="{StaticResource iOSBlue}"
                                                StrokeThickness="0"
                                                Stroke="Transparent"
                                                Padding="7,2"
                                                MinimumWidthRequest="22"
                                                MinimumHeightRequest="22">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding UnreadLabel}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Separator -->
                                <BoxView HeightRequest="0.5"
                                         Color="{StaticResource iOSGray5}"
                                         Margin="76,0,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>
