<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgendaBuddy.MobileApp.Views.PaymentPage"
             Title="Payment"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource Primary}"
              Padding="24,48,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0"
                    Text="&#x2190; Back"
                    BackgroundColor="Transparent"
                    TextColor="#C7D2FE"
                    FontSize="14"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,0,0,16"
                    Clicked="OnBackClicked" />
            <Label Grid.Row="1"
                   Text="Payment"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White" />
        </Grid>

        <!-- Error banner -->
        <Frame Grid.Row="1"
               Style="{StaticResource ErrorBannerStyle}"
               IsVisible="{Binding HasError}"
               Margin="24,12"
               VerticalOptions="Start">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}"
                       FontSize="14"
                       VerticalOptions="Center"
                       AutomationId="ErrorBanner" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="16"
                        FontSize="13"
                        Padding="12,6"
                        HeightRequest="36"
                        AutomationId="TryAgainButton" />
            </Grid>
        </Frame>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Payment -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasPayment}">
            <VerticalStackLayout Padding="24" Spacing="14">

                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       BorderColor="#E2E8F0"
                       HasShadow="True"
                       Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Payment.Amount, StringFormat='{0:C}'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- ux-review.md finding 1 / AC13: never "Paid" for a local_-prefixed
                             (non-charging) payment — the exact copy for that state. -->
                        <Label Text="{Binding StatusMessage}"
                               FontSize="15"
                               TextColor="{StaticResource TextSecondary}"
                               AutomationId="PaymentStatusLabel" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
