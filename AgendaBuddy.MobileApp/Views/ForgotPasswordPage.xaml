<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.ForgotPasswordPage"
             Title="Forgot Password"
             BackgroundColor="{StaticResource BackgroundDark}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid VerticalOptions="Center" Padding="24">
            <Frame BackgroundColor="{StaticResource BackgroundCard}" CornerRadius="24" BorderColor="Transparent" HasShadow="True" Padding="32">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Reset your password" Style="{StaticResource TitleLarge}" HorizontalOptions="Center" Margin="0,0,0,4" />
                    <Label Text="Enter your account email and we'll start a password reset."
                           Style="{StaticResource BodySecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,16" />

                    <VerticalStackLayout IsVisible="{Binding IsSubmitted, Converter={StaticResource InvertedBoolConverter}}" Spacing="8">
                        <Label Text="Email" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Frame Style="{StaticResource InputFrame}">
                            <Entry Placeholder="you@example.com" Keyboard="Email" Text="{Binding Email}"
                                   Style="{StaticResource InputStyle}" AutomationId="ForgotPasswordEmailEntry" />
                        </Frame>

                        <Frame Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasError}">
                            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="14" AutomationId="ForgotPasswordErrorLabel" />
                        </Frame>

                        <Grid Margin="0,12,0,0">
                            <Button Text="Send Reset Link"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SubmitCommand}"
                                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                    AutomationId="SendResetLinkButton" />
                            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                               Color="{StaticResource Primary}" HorizontalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsSubmitted}" Spacing="10">
                        <Label Text="If that email has an account, a reset link has been sent."
                               Style="{StaticResource Body}" HorizontalTextAlignment="Center" AutomationId="ForgotPasswordSubmittedLabel" />
                        <Button Text="I have a reset code" Style="{StaticResource SecondaryButton}" Clicked="OnHaveCodeTapped" />
                    </VerticalStackLayout>

                    <Label HorizontalOptions="Center" Margin="0,16,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Back to " TextColor="{StaticResource TextMuted}" FontSize="14" />
                                <Span Text="Sign In" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="14">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>

</ContentPage>
