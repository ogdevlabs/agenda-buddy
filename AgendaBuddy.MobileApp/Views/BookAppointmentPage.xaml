<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AgendaBuddy.MobileApp.Resources.Strings"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.BookAppointmentPage"
             x:Name="ThisPage"
             Title="{x:Static strings:AppResources.Xaml_BookAppointment}"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <controls:BrandHeader Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="1"
                       Text="{Binding CounterpartName}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Grid>

            <!-- Bottom padding clears the pinned confirm bar, so the last time chips can be scrolled into view
                 rather than sitting permanently behind it. -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,20,20,24" Spacing="14">

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}" HorizontalOptions="Center" />

                    <Frame Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="14" />
                    </Frame>

                    <!-- A provider with nothing bookable cannot be booked; say so rather than showing an
                         empty calendar the customer will poke at. -->
                    <Frame CornerRadius="20" BackgroundColor="White" BorderColor="#E2E8F0" HasShadow="True"
                           Padding="20" IsVisible="{Binding HasNoServices}">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.Xaml_NothingBookableYet}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                            <Label Text="{x:Static strings:AppResources.Xaml_ThisProviderHasNotPublishedAnyServicesYouCanBook}"
                                   FontSize="13" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- STEP 1 — service. Availability depends on its duration, so it is chosen first. -->
                    <Frame CornerRadius="20" BackgroundColor="White" BorderColor="#E2E8F0" HasShadow="True"
                           Padding="20" IsVisible="{Binding HasServices}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{x:Static strings:AppResources.Xaml_1CHOOSEASERVICE}" FontSize="11" TextColor="{StaticResource TextMuted}"
                                   CharacterSpacing="1.5" />

                            <CollectionView ItemsSource="{Binding Services}" SelectionMode="None"
                                            AutomationId="ServiceChoiceCollectionView">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame CornerRadius="14" BackgroundColor="White" BorderColor="#E2E8F0"
                                               HasShadow="False" Padding="14" Margin="0,0,0,8"
                                               AutomationId="ServiceChoice">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectServiceCommand}"
                                                    CommandParameter="{Binding}" />
                                            </Frame.GestureRecognizers>
                                            <!-- Chosen state is a tinted fill plus a heavier accent border, so it
                                                 survives greyscale and does not rely on colour alone. -->
                                            <Frame.Triggers>
                                                <DataTrigger TargetType="Frame" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimarySubtle}" />
                                                    <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Frame.Triggers>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                    <Label Text="{Binding Description}" FontSize="13"
                                                           TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding DurationLabel}" FontSize="12"
                                                           TextColor="{StaticResource TextMuted}" />
                                                    <Label Text="{Binding FeeLabel}" FontSize="12"
                                                           TextColor="{StaticResource TextMuted}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="&#x2713;"
                                                       FontSize="20"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}"
                                                       VerticalOptions="Center"
                                                       Margin="8,0,0,0"
                                                       IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="{Binding SelectedServiceLabel}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" IsVisible="{Binding HasSelectedService}"
                                   AutomationId="SelectedServiceLabel" />
                        </VerticalStackLayout>
                    </Frame>

                    <ActivityIndicator IsRunning="{Binding IsLoadingAvailability}"
                                       IsVisible="{Binding IsLoadingAvailability}"
                                       Color="{StaticResource Primary}" HorizontalOptions="Center" />

                    <!-- Fully booked is a normal state, not an error. -->
                    <Frame CornerRadius="20" BackgroundColor="White" BorderColor="#E2E8F0" HasShadow="True"
                           Padding="20" IsVisible="{Binding IsFullyBooked}">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.Xaml_NoAvailability}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                            <Label Text="{x:Static strings:AppResources.Xaml_ThisProviderHasNoFreeSlotsForThatServiceInTheNext90Days}"
                                   FontSize="13" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- STEPS 2 & 3 — date, then time, from the provider's real free slots. The shared
                         SlotPicker control, so a provider rescheduling and a customer proposing a new time get
                         the identical interaction and the identical timezone handling. It renders its own
                         loading, error, fully-booked and selected states. -->
                    <Frame CornerRadius="20" BackgroundColor="White" BorderColor="#E2E8F0" HasShadow="True"
                           Padding="20" IsVisible="{Binding HasSelectedService}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{x:Static strings:AppResources.Xaml_2CHOOSEADATEANDTIME}" FontSize="11"
                                   TextColor="{StaticResource TextMuted}" CharacterSpacing="1.5" />

                            <controls:SlotPicker BindingContext="{Binding Picker}" />
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Confirm bar. Deliberately OUTSIDE the ScrollView: as the last card in a scrolling column it
                 measured below the fold behind the tab bar, so the customer had to scroll blind to reach the
                 one action that commits money and time. The command stays disabled until a service AND a slot
                 are chosen, so a half-made booking is not expressible. -->
            <Frame Grid.Row="2"
                   BackgroundColor="White"
                   BorderColor="#E2E8F0"
                   CornerRadius="0"
                   HasShadow="True"
                   Padding="20,14,20,16"
                   IsVisible="{Binding HasSelectedService}">
                <VerticalStackLayout Spacing="10">

                    <!-- Before a slot exists there is nothing to summarise; say what is still needed rather
                         than showing an empty summary above a dead button. -->
                    <Label Text="{Binding ConfirmPrompt}"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding ShowConfirmPrompt}"
                           AutomationId="ConfirmPromptLabel" />

                    <!-- The whole commitment, restated at the point of commitment — but in three lines, not a
                         stacked block. This bar is pinned, so every extra row it takes is a row of the time
                         grid the customer can no longer see while choosing. -->
                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HasSelectedSlot}"
                                         AutomationId="BookingSummary">

                        <!-- When and how long. -->
                        <Label FontSize="16" TextColor="{StaticResource TextPrimary}"
                               AutomationId="SummaryWhenLabel">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SummaryDate}" FontAttributes="Bold" />
                                    <Span Text="  ·  " TextColor="{StaticResource TextMuted}" />
                                    <Span Text="{Binding SummaryTimeRange}" FontAttributes="Bold"
                                          TextColor="{StaticResource Primary}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Duration, and the zone the times above are expressed in — a time with no zone is
                             ambiguous the moment the two parties are not in the same one. -->
                        <Label FontSize="11" TextColor="{StaticResource TextMuted}"
                               AutomationId="SummaryDurationZoneLabel">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SummaryDuration}" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding SummaryTimeZone}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- What, with whom, for how much. -->
                        <Label FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="0,3,0,0"
                               AutomationId="SummaryWhatLabel">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SummaryService}" FontAttributes="Bold"
                                          TextColor="{StaticResource TextPrimary}" />
                                    <Span Text="{x:Static strings:AppResources.Xaml_With}" />
                                    <Span Text="{Binding SummaryWith}" TextColor="{StaticResource TextPrimary}" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding SummaryPrice}" FontAttributes="Bold"
                                          TextColor="{StaticResource TextPrimary}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Kept for tests and for assistive tech, which reads the whole selection in one string. -->
                        <Label Text="{Binding SelectedSlotLabel}" IsVisible="False"
                               AutomationId="SelectedSlotLabel" />
                    </VerticalStackLayout>

                    <Grid>
                        <controls:SafeButton Text="{x:Static strings:AppResources.Xaml_ConfirmBooking}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BookCommand}"
                                IsVisible="{Binding IsBooking, Converter={StaticResource InvertedBoolConverter}}"
                                AutomationId="ConfirmBookButton" />
                        <ActivityIndicator IsRunning="{Binding IsBooking}" IsVisible="{Binding IsBooking}"
                                           Color="{StaticResource Primary}" HorizontalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </Grid>

    </Grid>

</ContentPage>
