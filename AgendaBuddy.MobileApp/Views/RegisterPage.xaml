<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.RegisterPage"
             Title="Create Account"
             BackgroundColor="{StaticResource BackgroundDark}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid VerticalOptions="Center" Padding="24">

            <!-- Main card -->
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   CornerRadius="24"
                   BorderColor="Transparent"
                   HasShadow="True"
                   Padding="32">

                <VerticalStackLayout Spacing="8">

                    <!-- Brand area -->
                    <VerticalStackLayout Spacing="4" Margin="0,0,0,20">
                        <Frame BackgroundColor="{StaticResource PrimarySubtle}"
                               CornerRadius="20"
                               WidthRequest="64"
                               HeightRequest="64"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent"
                               HorizontalOptions="Center"
                               Margin="0,0,0,16">
                            <Label Text="AB"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="Create Account"
                               Style="{StaticResource TitleLarge}"
                               HorizontalOptions="Center" />

                        <Label Text="Start managing your schedule"
                               Style="{StaticResource BodySecondary}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- Email -->
                    <Label Text="Email"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,0,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="you@example.com"
                               Keyboard="Email"
                               Text="{Binding Email}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterEmailEntry" />
                    </Frame>

                    <!-- Password -->
                    <Label Text="Password"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="At least 8 characters"
                               IsPassword="True"
                               Text="{Binding Password}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterPasswordEntry" />
                    </Frame>

                    <!-- Confirm Password -->
                    <Label Text="Confirm Password"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="Re-enter your password"
                               IsPassword="True"
                               Text="{Binding ConfirmPassword}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterConfirmPasswordEntry" />
                    </Frame>

                    <!-- Role selection (segmented style) -->
                    <Label Text="I am a..."
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,12,0,4" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Provider option -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource PrimarySubtle}"
                                Padding="12,14"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <RadioButton Content="Provider"
                                             IsChecked="{Binding IsProvider}"
                                             TextColor="{StaticResource Primary}"
                                             AutomationId="ProviderRadio" />
                                <Label Text="I offer services"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Customer option -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BorderMedium}"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource BackgroundCard}"
                                Padding="12,14"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <RadioButton Content="Customer"
                                             TextColor="{StaticResource TextPrimary}"
                                             AutomationId="CustomerRadio" />
                                <Label Text="I book services"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Error message -->
                    <Frame Style="{StaticResource ErrorBannerStyle}"
                           IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="14"
                               AutomationId="RegisterErrorLabel" />
                    </Frame>

                    <!-- Register button + activity indicator -->
                    <Grid Margin="0,16,0,0">
                        <controls:SafeButton Text="Create Account"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RegisterCommand}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                AutomationId="RegisterButton" />
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>

                    <!-- Navigate to login -->
                    <Label HorizontalOptions="Center" Margin="0,16,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Already have an account? "
                                      TextColor="{StaticResource TextMuted}"
                                      FontSize="14" />
                                <Span Text="Sign In"
                                      TextColor="{StaticResource Primary}"
                                      FontAttributes="Bold"
                                      FontSize="14">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </VerticalStackLayout>
            </Frame>

        </Grid>
    </ScrollView>

</ContentPage>
