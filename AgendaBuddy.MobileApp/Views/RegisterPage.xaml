<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AgendaBuddy.MobileApp.Resources.Strings"
             xmlns:infrastructure="clr-namespace:AgendaBuddy.MobileApp.Infrastructure"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.RegisterPage"
             Title="{x:Static strings:AppResources.Xaml_CreateAccount}"
             BackgroundColor="{StaticResource BackgroundDark}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid VerticalOptions="Center" Padding="24">

            <!-- Main card -->
            <Frame BackgroundColor="{StaticResource BackgroundCard}"
                   CornerRadius="24"
                   BorderColor="Transparent"
                   HasShadow="True"
                   Padding="32">

                <VerticalStackLayout Spacing="8">

                    <!-- Brand area -->
                    <VerticalStackLayout Spacing="4" Margin="0,0,0,20">
                        <Frame BackgroundColor="{StaticResource PrimarySubtle}"
                               CornerRadius="20"
                               WidthRequest="64"
                               HeightRequest="64"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent"
                               HorizontalOptions="Center"
                               Margin="0,0,0,16">
                            <Label Text="{x:Static infrastructure:AppBrand.Monogram}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="{x:Static strings:AppResources.Xaml_CreateAccount}"
                               Style="{StaticResource TitleLarge}"
                               HorizontalOptions="Center" />

                        <Label Text="{x:Static strings:AppResources.Xaml_StartManagingYourSchedule}"
                               Style="{StaticResource BodySecondary}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- Name. Required: it is what the other party sees on a booking. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{x:Static strings:AppResources.Xaml_FirstName_fe8083f8}"
                                   Style="{StaticResource Caption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="4,0,0,0" />
                            <Frame Style="{StaticResource InputFrame}">
                                <Entry Placeholder="Casey"
                                       Text="{Binding FirstName}"
                                       Style="{StaticResource InputStyle}"
                                       AutomationId="RegisterFirstNameEntry" />
                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{x:Static strings:AppResources.Xaml_LastName_6a4108c8}"
                                   Style="{StaticResource Caption}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="4,0,0,0" />
                            <Frame Style="{StaticResource InputFrame}">
                                <Entry Placeholder="{x:Static strings:AppResources.Example_LastName}"
                                       Text="{Binding LastName}"
                                       Style="{StaticResource InputStyle}"
                                       AutomationId="RegisterLastNameEntry" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Email -->
                    <Label Text="{x:Static strings:AppResources.Xaml_Email}"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="{x:Static strings:AppResources.Example_Email}"
                               Keyboard="Email"
                               Text="{Binding Email}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterEmailEntry" />
                    </Frame>

                    <!-- Phone. Optional, and labelled so, but asked for here because it is the only
                         fallback channel when a session is about to be missed. -->
                    <Label Text="{x:Static strings:AppResources.Xaml_PhoneOptional}"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="555 123 4567"
                               Keyboard="Telephone"
                               Text="{Binding PhoneNumber}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterPhoneEntry" />
                    </Frame>

                    <!-- Password -->
                    <Label Text="{x:Static strings:AppResources.Xaml_Password}"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="{x:Static strings:AppResources.Xaml_AtLeast8Characters}"
                               IsPassword="True"
                               Text="{Binding Password}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterPasswordEntry" />
                    </Frame>

                    <!-- Confirm Password -->
                    <Label Text="{x:Static strings:AppResources.Xaml_ConfirmPassword}"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="{x:Static strings:AppResources.Xaml_ReEnterYourPassword}"
                               IsPassword="True"
                               Text="{Binding ConfirmPassword}"
                               Style="{StaticResource InputStyle}"
                               AutomationId="RegisterConfirmPasswordEntry" />
                    </Frame>

                    <!-- Role selection (segmented style) -->
                    <Label Text="{x:Static strings:AppResources.Xaml_IAmA}"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="4,12,0,4" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Provider option -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource PrimarySubtle}"
                                Padding="12,14"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <RadioButton Content="Provider"
                                             IsChecked="{Binding IsProvider}"
                                             TextColor="{StaticResource Primary}"
                                             AutomationId="ProviderRadio" />
                                <Label Text="{x:Static strings:AppResources.Xaml_IOfferServices}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Customer option -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BorderMedium}"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource BackgroundCard}"
                                Padding="12,14"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <RadioButton Content="Customer"
                                             TextColor="{StaticResource TextPrimary}"
                                             AutomationId="CustomerRadio" />
                                <Label Text="{x:Static strings:AppResources.Xaml_IBookServices}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Error message -->
                    <Frame Style="{StaticResource ErrorBannerStyle}"
                           IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="14"
                               AutomationId="RegisterErrorLabel" />
                    </Frame>

                    <!-- Register button + activity indicator -->
                    <Grid Margin="0,16,0,0">
                        <controls:SafeButton Text="{x:Static strings:AppResources.Xaml_CreateAccount}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RegisterCommand}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                AutomationId="RegisterButton" />
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>

                    <!-- Navigate to login -->
                    <Label HorizontalOptions="Center" Margin="0,16,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static strings:AppResources.Xaml_AlreadyHaveAnAccount}"
                                      TextColor="{StaticResource TextMuted}"
                                      FontSize="14" />
                                <Span Text="{x:Static strings:AppResources.Xaml_SignIn}"
                                      TextColor="{StaticResource Primary}"
                                      FontAttributes="Bold"
                                      FontSize="14">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </VerticalStackLayout>
            </Frame>

        </Grid>
    </ScrollView>

</ContentPage>
