<?xml version="1.0" encoding="utf-8"?>
<!--
    Subscribes the phone's own calendar to the account's feed. Three states: off, on with the link on this
    device, and on without it (the link is shown once). The subscribe and turn-on actions are pinned; copy, reset
    and turn off are secondary and live with the explanation. Laid out like CalendarSettingsPage: the two are the
    same family of screen and are reached from the same places.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AgendaBuddy.MobileApp.Resources.Strings"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             x:Class="AgendaBuddy.MobileApp.Views.CalendarSyncPage"
             Title="{x:Static strings:AppResources.CalendarSync_Title}"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <controls:BrandHeader Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Padding="20,12,20,16" RowSpacing="12">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <Label Grid.Column="1" Text="{x:Static strings:AppResources.CalendarSync_Title}" FontSize="22"
                       FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"
                       Margin="8,0,0,0" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="12">

                <Frame Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="14"
                           AutomationId="CalendarSyncError" />
                </Frame>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center" />

            </VerticalStackLayout>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="14">

                    <Frame CornerRadius="16" BackgroundColor="White" BorderColor="{StaticResource BorderLight}"
                           HasShadow="True" Padding="16" IsVisible="{Binding IsLoaded}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{x:Static strings:AppResources.CalendarSync_Overline}" FontSize="11"
                                   TextColor="{StaticResource TextMuted}" TextTransform="Uppercase"
                                   CharacterSpacing="1.5" />
                            <Label Text="{x:Static strings:AppResources.CalendarSync_On}"
                                   IsVisible="{Binding IsEnabled}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource Success}"
                                   AutomationId="CalendarSyncOnLabel" />

                            <Label Text="{x:Static strings:AppResources.CalendarSync_Explainer}"
                                   IsVisible="{Binding IsOff}"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{x:Static strings:AppResources.CalendarSync_AfterAdding}"
                                   IsVisible="{Binding IsOnWithLink}"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{x:Static strings:AppResources.CalendarSync_NoLinkHere}"
                                   IsVisible="{Binding IsOnWithoutLink}"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                                   AutomationId="CalendarSyncNoLinkLabel" />
                            <Label Text="{x:Static strings:AppResources.CalendarSync_Privacy}"
                                   FontSize="12" TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame CornerRadius="16" BackgroundColor="White" BorderColor="{StaticResource BorderLight}"
                           HasShadow="True" Padding="16" IsVisible="{Binding IsOnWithLink}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{x:Static strings:AppResources.CalendarSync_LinkOverline}" FontSize="11"
                                   TextColor="{StaticResource TextMuted}" TextTransform="Uppercase"
                                   CharacterSpacing="1.5" />
                            <controls:SafeButton Style="{StaticResource SecondaryButton}"
                                                 Text="{x:Static strings:AppResources.CalendarSync_CopyLink}"
                                                 Command="{Binding CopyLinkCommand}"
                                                 AutomationId="CalendarSyncCopyButton" />
                            <controls:SafeButton Style="{StaticResource SecondaryButton}"
                                                 Text="{x:Static strings:AppResources.CalendarSync_Reset}"
                                                 Command="{Binding ResetLinkCommand}"
                                                 AutomationId="CalendarSyncResetButton" />
                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" FontSize="13"
                           TextColor="{StaticResource TextMuted}" AutomationId="CalendarSyncStatus" />

                    <controls:SafeButton Style="{StaticResource DangerButton}"
                                         IsVisible="{Binding IsEnabled}"
                                         Text="{x:Static strings:AppResources.CalendarSync_TurnOff}"
                                         Command="{Binding TurnOffCommand}"
                                         AutomationId="CalendarSyncTurnOffButton" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- Pinned: the one action each state is for. -->
            <VerticalStackLayout Grid.Row="3" Spacing="8">
                <controls:SafeButton Style="{StaticResource PrimaryButton}"
                                     HeightRequest="48"
                                     IsVisible="{Binding IsOff}"
                                     Text="{x:Static strings:AppResources.CalendarSync_TurnOn}"
                                     Command="{Binding TurnOnCommand}"
                                     AutomationId="CalendarSyncTurnOnButton" />
                <controls:SafeButton Style="{StaticResource PrimaryButton}"
                                     HeightRequest="48"
                                     IsVisible="{Binding IsOnWithoutLink}"
                                     Text="{x:Static strings:AppResources.CalendarSync_Reset}"
                                     Command="{Binding ResetLinkCommand}"
                                     AutomationId="CalendarSyncNewLinkButton" />
                <controls:SafeButton Style="{StaticResource PrimaryButton}"
                                     HeightRequest="48"
                                     IsVisible="{Binding IsOnWithLink}"
                                     Text="{Binding PrimarySubscribeLabel}"
                                     Command="{Binding SubscribePrimaryCommand}"
                                     AutomationId="CalendarSyncPrimarySubscribeButton" />
                <controls:SafeButton Style="{StaticResource SecondaryButton}"
                                     IsVisible="{Binding IsOnWithLink}"
                                     Text="{Binding SecondarySubscribeLabel}"
                                     Command="{Binding SubscribeSecondaryCommand}"
                                     AutomationId="CalendarSyncSecondarySubscribeButton" />
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
