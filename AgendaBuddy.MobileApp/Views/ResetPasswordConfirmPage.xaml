<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AgendaBuddy.MobileApp.Resources.Strings"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.ResetPasswordConfirmPage"
             Title="{x:Static strings:AppResources.Xaml_ResetPassword}"
             BackgroundColor="{StaticResource BackgroundDark}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid VerticalOptions="Center" Padding="24">
            <Frame BackgroundColor="{StaticResource BackgroundCard}" CornerRadius="24" BorderColor="Transparent" HasShadow="True" Padding="32">
                <VerticalStackLayout Spacing="8">

                    <Label Text="{x:Static strings:AppResources.Xaml_EnterYourResetCode}" Style="{StaticResource TitleLarge}" HorizontalOptions="Center" Margin="0,0,0,16" />

                    <Label Text="{x:Static strings:AppResources.Xaml_Email}" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="{x:Static strings:AppResources.Example_Email}" Keyboard="Email" Text="{Binding Email}"
                               Style="{StaticResource InputStyle}" AutomationId="ResetEmailEntry" />
                    </Frame>

                    <Label Text="{x:Static strings:AppResources.Xaml_ResetCode}" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="{x:Static strings:AppResources.Xaml_PasteTheCodeFromTheResetRequest}" Text="{Binding Token}"
                               Style="{StaticResource InputStyle}" AutomationId="ResetTokenEntry" />
                    </Frame>

                    <Label Text="{x:Static strings:AppResources.Xaml_NewPassword}" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                    <Frame Style="{StaticResource InputFrame}">
                        <Entry Placeholder="{x:Static strings:AppResources.Xaml_AtLeast8Characters}" IsPassword="True" Text="{Binding NewPassword}"
                               Style="{StaticResource InputStyle}" AutomationId="ResetNewPasswordEntry" />
                    </Frame>

                    <Frame Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" FontSize="14" AutomationId="ResetErrorLabel" />
                    </Frame>

                    <Grid Margin="0,16,0,0">
                        <controls:SafeButton Text="{x:Static strings:AppResources.Xaml_ResetPassword}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmCommand}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                AutomationId="ConfirmResetButton" />
                        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource Primary}" HorizontalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>

</ContentPage>
