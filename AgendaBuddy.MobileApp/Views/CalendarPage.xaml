<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:AgendaBuddy.MobileApp.Resources.Strings"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             x:Class="AgendaBuddy.MobileApp.Views.CalendarPage"
             x:Name="ThisPage"
             Title="{x:Static strings:AppResources.Xaml_Calendar}"
             BackgroundColor="{StaticResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="iOSBlue">#007AFF</Color>
        <Color x:Key="iOSRed">#FF3B30</Color>
        <Color x:Key="iOSGray">#8E8E93</Color>
        <Color x:Key="iOSGray5">#E5E5EA</Color>
        <Color x:Key="iOSLabel">#000000</Color>
        <Color x:Key="iOSSecondaryLabel">#3C3C4399</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <controls:BrandHeader Grid.Row="0" />

        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              AutomationId="AppointmentsView">

            <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="24,24,24,20">
                <Label Text="{x:Static strings:AppResources.Xaml_Calendar}"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Grid>

            <Border Grid.Row="1"
                    IsVisible="{Binding IsProvider}"
                    AutomationId="ManageCalendarButton"
                    Margin="16,12,16,0"
                    BackgroundColor="{StaticResource PrimarySubtle}"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Padding="14,11">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarSettingsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Text="&#x2699;" FontSize="17"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.Xaml_ManageCalendar}"
                               FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Text="{x:Static strings:AppResources.Xaml_WorkingDaysHoursAndTimeOff}"
                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#x276F;" FontSize="14"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="16,12,16,10"
                    Padding="3"
                    BackgroundColor="{StaticResource iOSGray5}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3" HeightRequest="44">
                    <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="Transparent"
                            AutomationId="ScheduledAppointmentsTab">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectAppointmentTabCommand}"
                                                  CommandParameter="Scheduled" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsScheduledTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Padding="6,0" VerticalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.Appointments_Scheduled}"
                                   FontSize="12" TextColor="{StaticResource iOSSecondaryLabel}"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsScheduledTab}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource iOSLabel}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding ScheduledCount}" FontSize="11"
                                   FontAttributes="Bold" TextColor="{StaticResource iOSGray}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="Transparent"
                            AutomationId="DoneAppointmentsTab">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectAppointmentTabCommand}"
                                                  CommandParameter="Done" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDoneTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Padding="6,0" VerticalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.Appointments_Done}"
                                   FontSize="12" TextColor="{StaticResource iOSSecondaryLabel}"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDoneTab}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource iOSLabel}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding DoneCount}" FontSize="11"
                                   FontAttributes="Bold" TextColor="{StaticResource iOSGray}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="Transparent"
                            AutomationId="CancelledAppointmentsTab">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectAppointmentTabCommand}"
                                                  CommandParameter="Cancelled" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCancelledTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Padding="6,0" VerticalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.Appointments_Cancelled}"
                                   FontSize="12" TextColor="{StaticResource iOSSecondaryLabel}"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCancelledTab}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource iOSLabel}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding CancelledCount}" FontSize="11"
                                   FontAttributes="Bold" TextColor="{StaticResource iOSGray}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Padding="16,0">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource iOSGray}"
                                   HorizontalOptions="Center"
                                   Margin="0,12" />
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="#FFF2F2"
                        Stroke="#FFD6D6"
                        StrokeThickness="1"
                        Padding="14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource iOSRed}"
                               FontSize="14" VerticalOptions="Center" />
                        <controls:SafeButton Grid.Column="1"
                                             Text="{x:Static strings:AppResources.Xaml_Retry}"
                                             Command="{Binding LoadCommand}"
                                             BackgroundColor="Transparent"
                                             TextColor="{StaticResource iOSBlue}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <CollectionView ItemsSource="{Binding DisplayedAppointments}"
                                SelectionMode="None"
                                Margin="16,4,16,16"
                                AutomationId="AppointmentsCollection">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" Stroke="#E5E5EA" StrokeThickness="1" Padding="14">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenAppointmentFromListCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:Avatar Size="44" Source="{Binding AvatarAsset}"
                                                     AutomationId="AppointmentAvatar" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource iOSLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding ServiceName}" FontSize="13"
                                               TextColor="{StaticResource iOSSecondaryLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding ListTimeLabel}" FontSize="13"
                                               TextColor="{StaticResource iOSGray}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource iOSBlue}" HorizontalTextAlignment="End" />
                                        <Label Text="&#x203A;" FontSize="22" TextColor="{StaticResource iOSGray}"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout IsVisible="{Binding AppointmentListIsEmpty}"
                                     Spacing="8" HorizontalOptions="Center" VerticalOptions="Center"
                                     Padding="36" AutomationId="AppointmentsEmptyState">
                    <Label Text="{Binding EmptyTitle}" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource iOSLabel}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptySubtitle}" FontSize="14"
                           TextColor="{StaticResource iOSGray}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Row="5"
                  IsVisible="{Binding HistoryPaginationIsVisible}"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="16,8,16,14"
                  BackgroundColor="White">
                <controls:SafeButton Text="&#x276E;"
                                     Command="{Binding PreviousHistoryPageCommand}"
                                     IsEnabled="{Binding CanGoBackInHistory}"
                                     BackgroundColor="Transparent"
                                     TextColor="{StaticResource iOSBlue}"
                                     WidthRequest="44" HeightRequest="40" />
                <Label Grid.Column="1" Text="{Binding HistoryPageLabel}"
                       FontSize="13" TextColor="{StaticResource iOSGray}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <controls:SafeButton Grid.Column="2" Text="&#x276F;"
                                     Command="{Binding NextHistoryPageCommand}"
                                     IsEnabled="{Binding CanGoForwardInHistory}"
                                     BackgroundColor="Transparent"
                                     TextColor="{StaticResource iOSBlue}"
                                     WidthRequest="44" HeightRequest="40" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>