<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:infrastructure="clr-namespace:AgendaBuddy.MobileApp.Infrastructure"
             xmlns:controls="clr-namespace:AgendaBuddy.MobileApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AgendaBuddy.MobileApp.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="#F2F2F7"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <Color x:Key="iOSBlue">#007AFF</Color>
        <Color x:Key="iOSRed">#FF3B30</Color>
        <Color x:Key="iOSGray">#8E8E93</Color>
        <Color x:Key="iOSGray5">#E5E5EA</Color>
        <Color x:Key="iOSLabel">#000000</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <controls:BrandHeader Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Header -->
            <Grid Grid.Row="0"
                  BackgroundColor="White"
                  Padding="20,16,20,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Notifications"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="{StaticResource iOSLabel}" />
                    <Label Grid.Column="1"
                           Text="{Binding UnreadCount, StringFormat='{0} unread'}"
                           FontSize="13"
                           TextColor="{StaticResource iOSGray}"
                           VerticalOptions="End"
                           Margin="0,0,0,4"
                           AutomationId="UnreadCountLabel"
                           IsVisible="{Binding HasUnread}" />
                </Grid>
            </Grid>

            <!--
                Filter and bulk-read, pinned above the list rather than inside it: an action that operates on
                the whole list must not scroll away with the list.
            -->
            <Grid Grid.Row="1"
                  BackgroundColor="White"
                  Padding="20,0,20,12"
                  ColumnDefinitions="Auto,*,Auto">
                <controls:SafeButton Grid.Column="0"
                        Text="{Binding UnreadFilterLabel}"
                        Command="{Binding ToggleUnreadFilterCommand}"
                        AutomationId="UnreadFilterButton"
                        BackgroundColor="Transparent"
                        Padding="0"
                        TextColor="{StaticResource iOSBlue}"
                        FontSize="14" />
                <controls:SafeButton Grid.Column="2"
                        Text="Mark all read"
                        Command="{Binding MarkAllReadCommand}"
                        IsEnabled="{Binding CanMarkAllRead}"
                        AutomationId="MarkAllReadButton"
                        BackgroundColor="Transparent"
                        Padding="0"
                        TextColor="{StaticResource iOSBlue}"
                        FontSize="14" />
            </Grid>

            <!-- Loading indicator -->
            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource iOSGray}"
                               HorizontalOptions="Center"
                               Margin="0,24" />

            <!-- Error banner -->
            <Frame Grid.Row="3"
                   BackgroundColor="#FFF2F2"
                   CornerRadius="10"
                   BorderColor="#FFD6D6"
                   Padding="14,10"
                   HasShadow="False"
                   IsVisible="{Binding HasError}"
                   Margin="16,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           TextColor="#FF3B30"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <controls:SafeButton Grid.Column="1"
                            Text="Retry"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource iOSBlue}"
                            FontAttributes="Bold"
                            FontSize="14" />
                </Grid>
            </Frame>

            <!-- Empty state -->
            <VerticalStackLayout Grid.Row="4"
                                 IsVisible="{Binding IsEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Padding="40">
                <Label Text="{Binding EmptyStateMessage}"
                       FontSize="16"
                       TextColor="{StaticResource iOSGray}"
                       HorizontalTextAlignment="Center"
                       AutomationId="EmptyStateLabel" />
            </VerticalStackLayout>

            <!-- Notifications list (iOS Notification Center style) -->
            <CollectionView Grid.Row="4"
                            ItemsSource="{Binding Notifications}"
                            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                            SelectionMode="None"
                            Margin="16,8,16,16">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Notification card (grouped card style like iOS) -->
                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="Transparent">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleNotificationCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout Spacing="0">

                                <!-- Header row: app icon + label + category + time -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                      Padding="14,10,14,0"
                                      ColumnSpacing="8">
                                    <!-- Small app icon -->
                                    <Grid Grid.Column="0"
                                          WidthRequest="20"
                                          HeightRequest="20"
                                          VerticalOptions="Center">
                                        <BoxView CornerRadius="5"
                                                 WidthRequest="20"
                                                 HeightRequest="20"
                                                 Color="{StaticResource iOSRed}" />
                                        <Label Text="{x:Static infrastructure:AppBrand.Monogram}"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Column="1"
                                           Text="{x:Static infrastructure:AppBrand.Name}"
                                           TextTransform="Uppercase"
                                           FontSize="12"
                                           TextColor="{StaticResource iOSGray}"
                                           VerticalOptions="Center"
                                           CharacterSpacing="0.5" />
                                    <!-- The category, which used to be the headline. It is a tag, not the news. -->
                                    <Label Grid.Column="2"
                                           Text="{Binding TypeLabel}"
                                           TextTransform="Uppercase"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource iOSGray}"
                                           VerticalOptions="Center"
                                           CharacterSpacing="0.5" />
                                    <Label Grid.Column="3"
                                           Text="{Binding TimeAgo}"
                                           FontSize="12"
                                           TextColor="{StaticResource iOSGray}"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Content: the producer's own subject and body, not a category word and a blank -->
                                <VerticalStackLayout Padding="14,6,14,14" Spacing="3">
                                    <Label Text="{Binding Title}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource iOSLabel}" />
                                    <Label Text="{Binding Message}"
                                           FontSize="14"
                                           TextColor="{StaticResource iOSGray}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="{Binding IsExpanded, Converter={toolkit:BoolToObjectConverter TrueObject=10, FalseObject=2}}" />
                                </VerticalStackLayout>

                                <!-- Expanded details -->
                                <VerticalStackLayout Spacing="4"
                                                     Margin="14,0,14,14"
                                                     IsVisible="{Binding IsExpanded}">
                                    <BoxView HeightRequest="0.5" Color="{StaticResource iOSGray5}" />
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:MMMM d, yyyy · h:mm tt}'}"
                                           FontSize="13"
                                           TextColor="{StaticResource iOSGray}"
                                           Margin="0,4,0,0" />
                                    <!--
                                        The way out of the notification. Only where there is an appointment
                                        that can still be opened: a message notification carries no identifier,
                                        and a cancellation names one that has been deleted. A button that
                                        navigates nowhere is worse than no button.
                                    -->
                                    <controls:SafeButton Text="View appointment"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewAppointmentCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding CanOpenAppointment}"
                                            AutomationId="ViewAppointmentButton"
                                            BackgroundColor="Transparent"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            TextColor="{StaticResource iOSBlue}"
                                            FontAttributes="Bold"
                                            FontSize="14" />
                                </VerticalStackLayout>

                                <!-- Unread indicator line at bottom -->
                                <BoxView HeightRequest="3"
                                         CornerRadius="1.5"
                                         Color="{Binding IsRead, Converter={toolkit:BoolToObjectConverter TrueObject=Transparent, FalseObject={StaticResource iOSBlue}}}"
                                         Margin="14,0,14,8"
                                         HorizontalOptions="Start"
                                         WidthRequest="40" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>
