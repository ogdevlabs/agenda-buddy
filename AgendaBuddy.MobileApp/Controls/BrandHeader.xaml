<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:infrastructure="clr-namespace:AgendaBuddy.MobileApp.Infrastructure"
             x:Class="AgendaBuddy.MobileApp.Controls.BrandHeader"
             x:Name="Root">

    <Grid RowDefinitions="Auto,3" Background="{StaticResource BrandGradient}">

        <!--
            Mark and wordmark are one lockup, centred as a group rather than each centred on its own — the
            mark reads as part of the name, not as decoration parked beside it.
        -->
        <Grid Grid.Row="0"
              HorizontalOptions="Center"
              ColumnDefinitions="Auto,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              Padding="20,12,20,12">

            <Border Grid.Column="0"
                    Grid.RowSpan="2"
                    WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="{StaticResource BrandBadgeFill}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    Padding="7">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="13" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="8" Offset="0,3" />
                </Border.Shadow>
                <Image Source="brand_mark.png" Aspect="AspectFit" />
            </Border>

            <!-- Tight tracking, not loose: a wordmark holds together, a label spaces out. -->
            <Label Grid.Column="1"
                   Grid.Row="0"
                   VerticalOptions="End"
                   AutomationId="BrandHeaderName">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static infrastructure:AppBrand.NameStem}"
                              FontSize="27"
                              FontAttributes="Bold"
                              CharacterSpacing="-0.4"
                              TextColor="{StaticResource TextOnPrimary}" />
                        <Span Text="{x:Static infrastructure:AppBrand.NameAccent}"
                              FontSize="27"
                              FontAttributes="Bold"
                              CharacterSpacing="-0.4"
                              TextColor="{StaticResource BrandAccent}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Hidden when signed out, and on any view that shows the user somewhere of its own. -->
            <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="7" VerticalOptions="Start">
                <HorizontalStackLayout.IsVisible>
                    <MultiBinding Converter="{toolkit:VariableMultiValueConverter ConditionType=All}">
                        <Binding Path="HasUser" />
                        <Binding Source="{x:Reference Root}" Path="ShowUser" />
                    </MultiBinding>
                </HorizontalStackLayout.IsVisible>
                <Label Text="{Binding DisplayName}"
                       FontSize="12.5"
                       FontAttributes="Bold"
                       CharacterSpacing="0.3"
                       TextColor="{StaticResource TextOnPrimary}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"
                       AutomationId="BrandHeaderUserName" />
                <!-- An amber dot rather than a middot: picks up the mark's accent and the wordmark's. -->
                <Ellipse WidthRequest="4"
                         HeightRequest="4"
                         Fill="{StaticResource BrandAccent}"
                         VerticalOptions="Center"
                         IsVisible="{Binding HasRole}" />
                <Label Text="{Binding RoleLabel}"
                       FontSize="12.5"
                       CharacterSpacing="0.8"
                       TextTransform="Uppercase"
                       TextColor="{StaticResource BrandHeaderUserRole}"
                       VerticalOptions="Center"
                       IsVisible="{Binding HasRole}"
                       AutomationId="BrandHeaderUserRole" />
            </HorizontalStackLayout>

        </Grid>

        <!-- Signature: the one amber line every screen shares, and what keeps the header from bleeding into
             a banner underneath it. -->
        <BoxView Grid.Row="1" Color="{StaticResource BrandAccent}" />

    </Grid>

</ContentView>
