<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:infrastructure="clr-namespace:AgendaBuddy.MobileApp.Infrastructure"
             x:Class="AgendaBuddy.MobileApp.Controls.BrandHeader">

    <Grid BackgroundColor="{StaticResource Primary}" Padding="20,10" RowSpacing="1">
        <Label Text="{x:Static infrastructure:AppBrand.Name}"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="{StaticResource TextOnPrimary}"
               VerticalOptions="Center"
               AutomationId="BrandHeaderName" />
    </Grid>

</ContentView>
