<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is permitted for the LOOPBACK HOST ONLY, so a local AppHost run is reachable from the
    emulator. Android 9+ blocks cleartext by default, and the local Gateway is http on port 6080.

    Deliberately not `android:usesCleartextTraffic="true"`, which would allow plaintext to ANY host and would
    apply to the released app: a downgrade attack on a real user's traffic is a much larger hole than the
    convenience is worth. 10.0.2.2 is the alias the emulator reaches the host machine on; 127.0.0.1/localhost
    cover a device connected over `adb reverse`.

    This file is referenced from the manifest in DEBUG builds only - see AndroidManifest.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
