<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgendaBuddy.MobileApp.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================ -->
            <!-- COLOR PALETTE                                -->
            <!-- ============================================ -->

            <!-- Primary -->
            <Color x:Key="Primary">#4F46E5</Color>
            <Color x:Key="PrimaryDark">#3730A3</Color>
            <Color x:Key="PrimaryLight">#818CF8</Color>
            <Color x:Key="PrimarySubtle">#EEF2FF</Color>

            <!-- Accent (Warm Amber) -->
            <Color x:Key="Accent">#F59E0B</Color>
            <Color x:Key="AccentDark">#D97706</Color>
            <Color x:Key="AccentLight">#FDE68A</Color>

            <!-- Semantic -->
            <Color x:Key="Success">#10B981</Color>
            <Color x:Key="SuccessLight">#D1FAE5</Color>
            <Color x:Key="SuccessSubtle">#ECFDF5</Color>
            <Color x:Key="Error">#EF4444</Color>
            <Color x:Key="ErrorLight">#FEE2E2</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="WarningLight">#FEF3C7</Color>
            <Color x:Key="Info">#3B82F6</Color>
            <Color x:Key="InfoLight">#DBEAFE</Color>

            <!-- Neutrals -->
            <Color x:Key="TextPrimary">#1E293B</Color>
            <Color x:Key="TextSecondary">#64748B</Color>
            <Color x:Key="TextMuted">#94A3B8</Color>
            <Color x:Key="TextOnDark">#F8FAFC</Color>
            <Color x:Key="TextOnPrimary">#FFFFFF</Color>

            <Color x:Key="BackgroundPage">#F8FAFC</Color>
            <Color x:Key="BackgroundCard">#FFFFFF</Color>
            <Color x:Key="BackgroundDark">#1E1B4B</Color>
            <Color x:Key="BackgroundElevated">#FFFFFF</Color>

            <Color x:Key="BorderLight">#E2E8F0</Color>
            <Color x:Key="BorderMedium">#CBD5E1</Color>
            <Color x:Key="Divider">#F1F5F9</Color>

            <!-- ============================================ -->
            <!-- TYPOGRAPHY STYLES                            -->
            <!-- ============================================ -->

            <Style x:Key="TitleLarge" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="TitleMedium" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="TitleSmall" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="BodySecondary" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>

            <Style x:Key="Overline" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="CharacterSpacing" Value="1.5" />
                <Setter Property="TextTransform" Value="Uppercase" />
            </Style>

            <!-- ============================================ -->
            <!-- COMPONENT STYLES                             -->
            <!-- ============================================ -->

            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderColor" Value="#F1F5F9" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Card Style (compact) -->
            <Style x:Key="CardCompact" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderColor" Value="#F1F5F9" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- Primary Button -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Secondary Button (outline) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Success Button -->
            <Style x:Key="SuccessButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Danger Button (outline) -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Error}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="BorderColor" Value="{StaticResource Error}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Input Style (Entry) -->
            <Style x:Key="InputStyle" TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <!-- Input Frame (wraps Entry for rounded look) -->
            <Style x:Key="InputFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderColor" Value="{StaticResource BorderMedium}" />
                <Setter Property="Padding" Value="16,4" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- Error Banner Style -->
            <Style x:Key="ErrorBannerStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource ErrorLight}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderColor" Value="{StaticResource Error}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Avatar Circle -->
            <Style x:Key="AvatarCircle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BackgroundColor" Value="{StaticResource PrimarySubtle}" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

            <!-- Badge Style -->
            <Style x:Key="BadgeStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
