<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgendaBuddy.MobileApp.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================ -->
            <!-- COLOR PALETTE                                -->
            <!-- ============================================ -->

            <!-- Primary -->
            <Color x:Key="Primary">#087F6A</Color>
            <Color x:Key="PrimaryDark">#075E54</Color>
            <Color x:Key="PrimaryLight">#55B5A2</Color>
            <Color x:Key="PrimarySubtle">#E7F5F1</Color>

            <!-- Accent: warm attention, never routine navigation. -->
            <Color x:Key="Accent">#D79B2B</Color>
            <Color x:Key="AccentDark">#A76E0A</Color>
            <Color x:Key="AccentLight">#F8E7B5</Color>

            <!-- Semantic -->
            <Color x:Key="Success">#238A63</Color>
            <Color x:Key="SuccessLight">#CFEADF</Color>
            <Color x:Key="SuccessSubtle">#EDF8F3</Color>
            <Color x:Key="Error">#EF4444</Color>
            <Color x:Key="ErrorLight">#FEE2E2</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="WarningLight">#FEF3C7</Color>
            <Color x:Key="Info">#2F6FB0</Color>
            <Color x:Key="InfoLight">#E4EFF9</Color>

            <!-- Neutrals -->
            <Color x:Key="TextPrimary">#202725</Color>
            <Color x:Key="TextSecondary">#5E6965</Color>
            <Color x:Key="TextMuted">#84908B</Color>
            <Color x:Key="TextOnDark">#F8FAFC</Color>
            <Color x:Key="TextOnPrimary">#FFFFFF</Color>
            <!-- Secondary text on a Primary-filled surface: readable, but subordinate to TextOnPrimary. -->
            <Color x:Key="TextOnPrimaryMuted">#C8E7DE</Color>
            <!-- Brand accent: the "Me" half of the wordmark, and the user's own name wherever a screen
                 greets them. Warm against the indigo, so it reads as the thing that is about YOU. -->
            <Color x:Key="BrandAccent">#F3C969</Color>
            <!-- The header's two identity facts read as different KINDS of information, so they do not share
                 a colour: who you are (plain white, the one you scan for) vs what you are (cool, secondary). -->
            <Color x:Key="BrandHeaderUserRole">#A7D8CD</Color>
            <!-- The wordmark's backdrop. Three stops with real distance between them, so it reads as depth
                 rather than the single muddy purple two near-identical indigos gave. -->
            <Color x:Key="BrandGradientStart">#075E54</Color>
            <Color x:Key="BrandGradientMid">#087F6A</Color>
            <Color x:Key="BrandGradientEnd">#246B73</Color>
            <!-- The badge the mark sits on: solid white, the same treatment the auth screens already use. -->
            <Color x:Key="BrandBadgeFill">#FFFFFF</Color>

            <Color x:Key="BackgroundPage">#F7F9F8</Color>
            <Color x:Key="BackgroundCard">#FFFFFF</Color>
            <Color x:Key="BackgroundDark">#123B35</Color>
            <Color x:Key="BackgroundElevated">#FFFFFF</Color>

            <Color x:Key="BorderLight">#DCE4E1</Color>
            <Color x:Key="BorderMedium">#C6D0CC</Color>
            <Color x:Key="Divider">#EDF1EF</Color>

            <!-- Left-to-right rather than diagonal: two stacked elements using a diagonal ramp meet at
                 mismatched colours and show a seam. -->
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource BrandGradientStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource BrandGradientMid}" Offset="0.55" />
                <GradientStop Color="{StaticResource BrandGradientEnd}" Offset="1.0" />
            </LinearGradientBrush>

            <!-- ============================================ -->
            <!-- TYPOGRAPHY STYLES                            -->
            <!-- ============================================ -->

            <Style x:Key="TitleLarge" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="TitleMedium" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="TitleSmall" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="OperationalPageHeader" TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="Padding" Value="24,20" />
            </Style>

            <Style x:Key="OperationalPageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
            </Style>

            <Style x:Key="OperationalPageSubtitle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimaryMuted}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="BodySecondary" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            </Style>

            <Style x:Key="Overline" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="CharacterSpacing" Value="1.5" />
                <Setter Property="TextTransform" Value="Uppercase" />
            </Style>

            <!-- ============================================ -->
            <!-- COMPONENT STYLES                             -->
            <!-- ============================================ -->

            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderColor" Value="{StaticResource BorderLight}" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Card Style (compact) -->
            <Style x:Key="CardCompact" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderColor" Value="{StaticResource BorderLight}" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- Primary Button -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Secondary Button (outline) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Success Button -->
            <Style x:Key="SuccessButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Warning Button — amber, for an action that CHANGES a commitment rather than completing or
                 destroying one. Rescheduling is neither a success nor a danger: it moves something both parties
                 agreed to, which is why it reads in its own colour beside a green Complete and a red Cancel. -->
            <Style x:Key="WarningButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Warning}" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Danger Button (outline) -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Error}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderColor" Value="{StaticResource Error}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <!-- Input Style (Entry) -->
            <Style x:Key="InputStyle" TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <!-- Input Frame (wraps Entry for rounded look) -->
            <Style x:Key="InputFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderColor" Value="{StaticResource BorderMedium}" />
                <Setter Property="Padding" Value="16,4" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- Error Banner Style -->
            <Style x:Key="ErrorBannerStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource ErrorLight}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderColor" Value="{StaticResource Error}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Avatar Circle -->
            <Style x:Key="AvatarCircle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BackgroundColor" Value="{StaticResource PrimarySubtle}" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

            <!-- Badge Style -->
            <Style x:Key="BadgeStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
